      "id": "o6_1a.culture.wildbird",
      "rule_type": "obligation",
      "statement": "Wild herb and breeding areas are cereal with at least 20 cm double row spacing and no undersowing; 15 March–30 June has no driving, fertilisation, pesticides or mechanical weed control.",
      "conditions": [
        {
          "expression": "WB option requested",
          "description": "WB option requested",
          "input_paths": []
