      ]
    },
    {
      "id": "o6_1a.options.landscape_elements",
      "rule_type": "eligibility",
      "statement": "Point landscape elements must be controlled by the holding, within/on 5 m of agricultural land, crown diameter at least 2 m, at most 100 m² and 5 m apart.",
      "conditions": [
        {
          "expression": "landscape element option",
