        "data.oepul.o6_1a.violations"
      ]
    },
    {
      "id": "o6_1a.biodiv.divsz",
      "rule_type": "obligation",
      "statement": "DIVSZ first use is with second mowing of comparable parcels or one-cut meadow; use no earlier than 15 June and always allowed from 15 July; do not fertilise before first use.",
      "conditions": [
        {
          "expression": "DIVSZ",
          "description": "DIVSZ",
          "input_paths": []
        }
      ],
      "result": {
        "outcome": "variant_compliant",
        "description": "required"
      },
      "source_reference_ids": [
        "c.info.divsz"
      ],
      "rego_symbols": []
    },
    {
      "id": "o6_1a.biodiv.divnfz_rest",
      "rule_type": "obligation",
      "statement": "DIVNFZ requires at least nine weeks/63 calendar days without use, driving or fertilisation after first use, and a second use annually.",
      "conditions": [
        {
          "expression": "DIVNFZ",
          "description": "DIVNFZ",
          "input_paths": []
        },
        {
          "expression": "not eligible 2026 exception",
          "description": "not eligible 2026 exception",
          "input_paths": []
        }
      ],
      "result": {
        "outcome": "rest_days_minimum",
        "description": "63"
      },
      "source_reference_ids": [
        "c.info.divnfz"
      ],
      "rego_symbols": [
        "data.oepul.o6_1a.violations"
      ]
    },
    {
      "id": "o6_1a.biodiv.divagf",
      "rule_type": "obligation",
      "statement": "DIVAGF requires standing old grass over winter; final use is no later than 15 August and no driving/fertilisation until next year's use.",
      "conditions": [
        {
          "expression": "DIVAGF",
          "description": "DIVAGF",
          "input_paths": []
        }
      ],
      "result": {
        "outcome": "next_year_code",
        "description": "DIVSZ"
      },
      "source_reference_ids": [
        "c.info.divagf"
      ],
      "rego_symbols": []
    },
    {
      "id": "o6_1a.biodiv.regional_grassland",
      "rule_type": "option",
      "statement": "Grassland DIVRS needs Grünlandzahl at least 30, slope below 18%, 30 listed species from seven families, 20 kg/ha, documented regional origin, and no more than two uses.",
      "conditions": [
        {
          "expression": "grassland DIVRS option",
