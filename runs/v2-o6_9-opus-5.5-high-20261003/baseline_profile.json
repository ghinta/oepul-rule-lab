{
  "schema_version": "1.0",
  "farm": {
    "farm_id": "string",
    "year": "int",
    "region": {
      "nUTS": "string",
      "federal_state": "string",
      "district": "string",
      "municipality": "string",
      "is_mountain_area": "boolean",
      "is_protected_area": "boolean",
      "water_protection_zone": "boolean"
    },
    "certifications": {
      "organic": {
        "is_certified": "boolean",
        "in_conversion": "boolean",
        "conversion_start_year": "int|null",
        "control_body": "string|null"
      }
    }
  },
  "land": {
    "total_area_ha": "number",
    "arable_area_ha": "number",
    "grassland_area_ha": "number",
    "special_crops_area_ha": "number",
    "alpine_pasture_area_ha": "number",
    "parcels": [
      {
        "parcel_id": "string",
        "area_ha": "number",
        "land_use": "enum(arable|grassland|special_crop|alpine_pasture|other)",
        "slope_percent": "number|null",
        "soil_type": "string|null",
        "crop": {
          "crop_category": "enum(cereal|maize|oilseed|legume|root|vegetable|orchard|vineyard|hop|fallow|other)",
          "crop_name": "string|null"
        },
        "operations": {
          "tillage_type": "enum(plough|reduced|mulch|no_till|unknown)",
          "cover_crop": {
            "is_used": "boolean",
            "sowing_date": "date|null"
          },
          "psm_used": "boolean",
          "fertilizer": {
            "mineral_n_kg_per_ha": "number|null",
            "organic_n_kg_per_ha": "number|null"
          },
          "cutting_dates": [
            "date"
          ]
        },
        "constraints": {
          "is_contract_nature_area": "boolean",
          "biodiversity_area": {
            "is_biodiversity_area": "boolean",
            "type": "enum(annual|multi_year|null)",
            "commitment_years": "int|null"
          }
        }
      }
    ]
  },
  "livestock": {
    "has_livestock": "boolean",
    "species_groups": [
      {
        "species": "enum(cattle|pigs|sheep_goats|horses|poultry|rabbits|other)",
        "category": "string|null",
        "animal_count": "int",
        "gve": "number|null",
        "housing": {
          "housing_type": "enum(stall|pasture|mixed|unknown)",
          "stall": {
            "stall_id": "string|null",
            "stall_area_m2": "number|null",
            "lying_area_m2": "number|null",
            "floor_type": "enum(full_slatted|part_slatted|solid|deep_litter|unknown)",
            "bedding_type": "enum(straw|other|none|unknown)",
            "daylight_percentage": "number|null",
            "has_outdoor_area": "boolean|null",
            "ventilation_type": "enum(natural|mechanical|unknown)"
          },
          "pasture": {
            "pasture_area_ha": "number|null",
            "weide_days_per_year": "int|null",
            "weide_hours_per_day": "number|null",
            "distance_to_farm_km": "number|null",
            "water_availability": "boolean|null",
            "fencing": "enum(permanent|temporary|none|unknown)"
          }
        },
        "manure": {
          "manure_type": "enum(slurry|solid|mixed|none|unknown)",
          "application_technology": "enum(broadcast|trailing_hose|trailing_shoe|injection|incorporation|unknown)",
          "incorporation_time_hours": "number|null",
          "application_log_complete": "boolean"
        },
        "nh3_reduction": {
          "ammonia_reduction_technology": "string|null",
          "ammonia_reduction_percent": "number|null"
        }
      }
    ]
  },
  "documentation": {
    "nutrient_balance_complete": "boolean",
    "field_records_complete": "boolean",
    "livestock_records_complete": "boolean",
    "application_logs_complete": "boolean",
    "audit_last_year_noncompliance": "boolean"
  },
  "preferences_constraints": {
    "willing_to_change_operations": "boolean",
    "investment_budget_eur": "number|null",
    "labour_constraints": "string|null"
  }
}