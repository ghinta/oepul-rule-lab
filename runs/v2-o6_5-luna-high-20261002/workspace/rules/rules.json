{
  "contract_version": "rules-catalog-v2.0.0",
  "measure": "o6_5",
  "rules": [
    {"id":"o65-001","rule_type":"contract_period","statement":"Der Verpflichtungs- und Vertragszeitraum beträgt grundsätzlich ein Kalenderjahr vom 1. Jänner bis 31. Dezember.","conditions":[{"expression":"measure=o6_5","description":"Teilnahme an o6_5"}],"result":{"outcome":"contract_period","description":"Ein Kalenderjahr","value":"01-01..12-31"},"source_reference_ids":["sr-o65-sheet-p1","sr-o65-srl-p52"],"rego_symbols":["contract_year_valid"]},
    {"id":"o65-002","rule_type":"automatic_extension","statement":"Die Maßnahme verlängert sich um ein weiteres Förderjahr, wenn sie nicht abgemeldet wird.","conditions":[{"expression":"not withdrawn","description":"Keine Abmeldung"}],"result":{"outcome":"extend","description":"Verlängerung um ein Förderjahr","value":true},"source_reference_ids":["sr-o65-sheet-p1"],"rego_symbols":[]},
    {"id":"o65-003","rule_type":"minimum_participation","statement":"In jedem Förderjahr muss mindestens ein förderbares Tier teilnehmen; andernfalls erlischt der Vertrag.","conditions":[{"expression":"count(eligible_animals)>=1","description":"Mindestens ein förderbares Tier"}],"result":{"outcome":"eligible","description":"Mindestteilnahme erfüllt","value":true},"source_reference_ids":["sr-o65-sheet-p1","sr-o65-srl-p52"],"rego_symbols":["eligible"]},
    {"id":"o65-004","rule_type":"animal_scope","statement":"Teilnahme ist nur mit reinrassigen Tieren der Rassenliste aus Kapitel 8 beziehungsweise Anhang D möglich.","conditions":[{"expression":"animal.purebred=true and breed in data.breeds","description":"Reinrassigkeit und Rassenlistenmitgliedschaft"}],"result":{"outcome":"eligible_animal_scope","description":"Tier ist grundsätzlich rassenlistenfähig","value":true},"source_reference_ids":["sr-o65-sheet-p2","sr-o65-sheet-p8","sr-o65-annex-p9","sr-o65-srl-p52"],"rego_symbols":["breed_record","animal_eligible"]},
    {"id":"o65-005","rule_type":"breeding_program","statement":"Förderbare Tiere müssen Zuchttiere nach den Tierzuchtgesetzen und genehmigten Zuchtprogrammen mit dem Zuchtziel Erhalt der Rasse sein und regelmäßig eingesetzt werden.","conditions":[{"expression":"purebred and approved_breeding_program and regular_breeding_use","description":"Reinrassiges Zuchttier im genehmigten Programm"}],"result":{"outcome":"breeding_requirement","description":"Zuchtprogrammvoraussetzung erfüllt","value":true},"source_reference_ids":["sr-o65-sheet-p2","sr-o65-srl-p52"],"rego_symbols":["animal_eligible"]},
    {"id":"o65-006","rule_type":"female_breeding","statement":"Weibliche Tiere müssen regelmäßig im genehmigten Zuchtprogramm eingesetzt und nur reinrassig angepaart werden.","conditions":[{"expression":"animal.animal_type in [cow,mare,ewe,doe,sow]","description":"Weibliche Tierkategorie"}],"result":{"outcome":"female_breeding","description":"Regelmäßiger Zuchteinsatz und reinrassige Anpaarung","value":true},"source_reference_ids":["sr-o65-sheet-p2","sr-o65-srl-p52"],"rego_symbols":["category_requirements_satisfied"]},
    {"id":"o65-007","rule_type":"cow_requirement","statement":"Eine Kuh muss spätestens am Stichtag 01.04. einmal gekalbt haben und reinrassig angepaart werden.","conditions":[{"expression":"animal_type=cow and calved_by_stichtag and purebred_mating","description":"Kuhanforderungen"}],"result":{"outcome":"cow_eligible","description":"Kuh-Tierkategorie erfüllt","value":true},"source_reference_ids":["sr-o65-sheet-p2","sr-o65-srl-p52"],"rego_symbols":["category_requirements_satisfied"]},
    {"id":"o65-008","rule_type":"mare_requirement","statement":"Eine Stute muss bis 31.05. des Teilnahmejahres einmal gefohlt haben, die nächste Abfohlung muss innerhalb von 3,5 Jahren erfolgen.","conditions":[{"expression":"animal_type=mare and foaled_by_may31 and next_foaling_within_3_5_years","description":"Stutenanforderungen"}],"result":{"outcome":"mare_eligible","description":"Stutenanforderung erfüllt","value":true},"source_reference_ids":["sr-o65-sheet-p2","sr-o65-srl-p52"],"rego_symbols":["category_requirements_satisfied"]},
    {"id":"o65-009","rule_type":"ewe_requirement","statement":"Ein Mutterschaf muss spätestens am Stichtag einmal gelammt haben und reinrassig angepaart werden.","conditions":[{"expression":"animal_type=ewe and lambed_by_stichtag and purebred_mating","description":"Mutterschafanforderungen"}],"result":{"outcome":"ewe_eligible","description":"Mutterschafanforderung erfüllt","value":true},"source_reference_ids":["sr-o65-sheet-p2","sr-o65-srl-p52"],"rego_symbols":["category_requirements_satisfied"]},
    {"id":"o65-010","rule_type":"doe_requirement","statement":"Eine Mutterziege muss spätestens am Stichtag einmal gekitzt haben und reinrassig angepaart werden.","conditions":[{"expression":"animal_type=doe and kidded_by_stichtag and purebred_mating","description":"Mutterziegenanforderungen"}],"result":{"outcome":"doe_eligible","description":"Mutterziegenanforderung erfüllt","value":true},"source_reference_ids":["sr-o65-sheet-p2","sr-o65-srl-p52"],"rego_symbols":["category_requirements_satisfied"]},
    {"id":"o65-011","rule_type":"sow_requirement","statement":"Eine Zuchtsau muss bis zum Stichtag zumindest einmal reinrassig geferkelt haben; mindestens jeder zweite Wurf muss reinrassig sein.","conditions":[{"expression":"animal_type=sow and purebred_farroted_by_stichtag and every_second_litter_purebred","description":"Zuchtsauanforderungen"}],"result":{"outcome":"sow_eligible","description":"Zuchtsauanforderung erfüllt","value":true},"source_reference_ids":["sr-o65-sheet-p2","sr-o65-srl-p52"],"rego_symbols":["category_requirements_satisfied"]},
    {"id":"o65-012","rule_type":"male_breeding","statement":"Männliche Zuchttiere müssen regelmäßig und grundsätzlich jährlich im genehmigten Zuchtprogramm eingesetzt werden; ausgenommen ist das Jahr der Zulassung zur Zucht.","conditions":[{"expression":"animal_type in [bull,ram,buck,boar] and (breeding_year=year or admitted_to_breeding_year=year)","description":"Männlicher Zuchteinsatz"}],"result":{"outcome":"male_breeding","description":"Jährlicher Zuchteinsatz oder Zulassungsjahr","value":true},"source_reference_ids":["sr-o65-sheet-p2","sr-o65-srl-p52"],"rego_symbols":["annual_breeding_requirement_satisfied","category_requirements_satisfied"]},
    {"id":"o65-013","rule_type":"bull_age","statement":"Ein Zuchtstier muss am Stichtag mindestens 10 Monate alt sein.","conditions":[{"expression":"animal_type=bull and age_months_at_stichtag>=10","description":"Stieralter"}],"result":{"outcome":"age_requirement","description":"Mindestalter erfüllt","value":10},"source_reference_ids":["sr-o65-sheet-p2","sr-o65-srl-p52"],"rego_symbols":["category_requirements_satisfied"]},
    {"id":"o65-014","rule_type":"ram_boar_age","statement":"Ein Zuchtwidder und ein Zuchteber müssen am Stichtag mindestens 6 Monate alt sein.","conditions":[{"expression":"animal_type in [ram,boar] and age_months_at_stichtag>=6","description":"Widder-/Eberalter"}],"result":{"outcome":"age_requirement","description":"Mindestalter erfüllt","value":6},"source_reference_ids":["sr-o65-sheet-p2","sr-o65-srl-p52"],"rego_symbols":["category_requirements_satisfied"]},
    {"id":"o65-015","rule_type":"buck_age","statement":"Ein Zuchtbock muss am Stichtag mindestens 5 Monate alt sein.","conditions":[{"expression":"animal_type=buck and age_months_at_stichtag>=5","description":"Bockalter"}],"result":{"outcome":"age_requirement","description":"Mindestalter erfüllt","value":5},"source_reference_ids":["sr-o65-sheet-p2","sr-o65-srl-p52"],"rego_symbols":["category_requirements_satisfied"]},
    {"id":"o65-016","rule_type":"stallion_age","statement":"Ein Zuchthengst muss spätestens am 31.05. des Teilnahmejahres 2 Jahre alt sein.","conditions":[{"expression":"animal_type=stallion and age_years_at_may31>=2","description":"Hengstalter"}],"result":{"outcome":"age_requirement","description":"Mindestalter erfüllt","value":2},"source_reference_ids":["sr-o65-sheet-p2","sr-o65-srl-p52"],"rego_symbols":["category_requirements_satisfied"]},
    {"id":"o65-017","rule_type":"stallion_offspring","statement":"Ein Hengst über 5 Jahre muss am 31.05. mindestens ein lebend geborenes, in den letzten zwei Jahren registriertes Nachkommen im Zuchtbuch/Herdebuch haben.","conditions":[{"expression":"age_years_at_may31>5 and count(live_born_offspring_last_two_years)>=1","description":"Althengst-Nachkommen"}],"result":{"outcome":"offspring_requirement","description":"Nachkommensnachweis erforderlich und erfüllt","value":true},"source_reference_ids":["sr-o65-sheet-p2","sr-o65-srl-p52"],"rego_symbols":["stallion_old_animal_requirement_satisfied"]},
    {"id":"o65-018","rule_type":"holding_period","statement":"Beantragte Tiere sind vom 01.04. bis einschließlich 31.12. des Förderjahres am Betrieb zu halten.","conditions":[{"expression":"held_from<=year-04-01 and held_to>=year-12-31","description":"Reguläre Haltedauer"}],"result":{"outcome":"holding_requirement","description":"Haltedauer erfüllt","value":"01-04..12-31"},"source_reference_ids":["sr-o65-sheet-p3","sr-o65-srl-p53"],"rego_symbols":["holding_valid"]},
    {"id":"o65-019","rule_type":"vis_reporting","statement":"Halter von Schafen und Ziegen müssen Ab- und Zugänge lebender Tiere an das VIS melden.","conditions":[{"expression":"species in [sheep,goat] and live_movement","description":"Schaf-/Ziegenbewegung"}],"result":{"outcome":"vis_report","description":"VIS-Meldung erforderlich","value":true},"source_reference_ids":["sr-o65-sheet-p3"],"rego_symbols":["movement_report_required"]},
    {"id":"o65-020","rule_type":"equine_identification","statement":"Equiden müssen mit einer UELN identifiziert und an die Österreichische Equidendatenbank sowie das VIS gemeldet werden.","conditions":[{"expression":"species=horse","description":"Equid"}],"result":{"outcome":"equine_reporting","description":"UELN-Identifikation und Meldung","value":true},"source_reference_ids":["sr-o65-sheet-p3"],"rego_symbols":[]},
    {"id":"o65-021","rule_type":"data_responsibility","statement":"Die tierhaltende Person ist für Richtigkeit und Vollständigkeit der an AMA und VIS gemeldeten Tierinformationen verantwortlich.","conditions":[],"result":{"outcome":"responsibility","description":"Verantwortung für Tierdaten","value":true},"source_reference_ids":["sr-o65-sheet-p3"],"rego_symbols":[]},
    {"id":"o65-022","rule_type":"breeding_organization_deadline","statement":"Die verantwortliche Zuchtorganisation beurteilt die beantragten Tiere bis spätestens 10.02. des Folgejahres.","conditions":[{"expression":"confirmation_date<=year+1-02-10","description":"Bestätigung fristgerecht"}],"result":{"outcome":"confirmation_deadline","description":"Zuchtorganisationsbestätigung bis 10. Februar","value":"02-10"},"source_reference_ids":["sr-o65-sheet-p3","sr-o65-srl-p53"],"rego_symbols":[]},
    {"id":"o65-023","rule_type":"breeding_organization_confirmation","statement":"Die Bestätigung umfasst Zuchtbucheintragung, Tierkategorieanforderungen, genehmigtes Zuchtprogramm und bei Kühen Milchleistungskontrolle.","conditions":[{"expression":"organization_confirmation=true","description":"Bestätigung der Zuchtorganisation"}],"result":{"outcome":"confirmation_contents","description":"Bestätigung vollständig","value":true},"source_reference_ids":["sr-o65-sheet-p3","sr-o65-srl-p53","sr-o6-srl-p19"],"rego_symbols":[]},
    {"id":"o65-024","rule_type":"application","statement":"Förderbare Pferde, Schafe, Ziegen und Schweine werden einzeln im Mehrfachantrag mit Stichtag 01.04. beantragt; bei Pferden ist die UELN anzugeben.","conditions":[{"expression":"species in [horse,sheep,goat,pig] and individually_applied and reference_date=04-01","description":"Tierbezogene Antragstellung"}],"result":{"outcome":"application_required","description":"Einzelantrag erforderlich","value":true},"source_reference_ids":["sr-o65-sheet-p6","sr-o65-srl-p53"],"rego_symbols":[]},
    {"id":"o65-025","rule_type":"cattle_application","statement":"Bei Rindern ermittelt die AMA die förderbaren Tiere aus der Rinderdatenbank mit Stichtag 01.04.; Ersatztiere werden ebenfalls automatisch entnommen.","conditions":[{"expression":"species=cattle","description":"Rind"}],"result":{"outcome":"automatic_cattle_selection","description":"Automatische Ermittlung aus Rinderdatenbank","value":true},"source_reference_ids":["sr-o65-sheet-p6","sr-o65-srl-p53"],"rego_symbols":["cattle_database_replaces_reports"]},
    {"id":"o65-026","rule_type":"departure_reporting","statement":"Der Abgang von beantragten Pferden, Schafen, Ziegen oder Schweinen ist während der Haltedauer binnen 7 Tagen online an die AMA zu melden.","conditions":[{"expression":"species!=cattle and departure_during_holding","description":"Nicht-Rinder-Abgang"}],"result":{"outcome":"departure_report","description":"AMA-Meldung innerhalb von 7 Tagen","value":7},"source_reference_ids":["sr-o65-sheet-p3","sr-o65-sheet-p4","sr-o65-srl-p53"],"rego_symbols":["movement_report_timely"]},
    {"id":"o65-027","rule_type":"cattle_departure","statement":"Der Abgang von beantragten Rindern wird durch die Meldung an die Rinderdatenbank berücksichtigt und muss nicht gesondert gemeldet werden.","conditions":[{"expression":"species=cattle","description":"Rindabgang"}],"result":{"outcome":"no_separate_report","description":"Keine gesonderte AMA-Meldung","value":true},"source_reference_ids":["sr-o65-sheet-p4","sr-o65-srl-p53"],"rego_symbols":["cattle_database_replaces_reports"]},
    {"id":"o65-028","rule_type":"temporary_pasture","statement":"Vorübergehender Aufenthalt auf Zinsweiden, Almen oder Gemeinschaftsweiden ist kein Abgang, wenn die Verfügungsgewalt beim antragstellenden Betrieb bleibt.","conditions":[{"expression":"temporary_stay and control_remains_with_applicant","description":"Vorübergehender Aufenthalt ohne Kontrollverlust"}],"result":{"outcome":"not_departure","description":"Keine Abgangsmeldung aus diesem Grund","value":true},"source_reference_ids":["sr-o65-sheet-p4","sr-o65-srl-p53"],"rego_symbols":["temporary_stay_is_not_departure"]},
    {"id":"o65-029","rule_type":"replacement_period","statement":"Abgegangene Nicht-Rinder sind innerhalb von 5 Wochen mit einem förderbaren Tier derselben Rasse nachzubesetzen; die Frist gilt auch über den 31.12. hinaus.","conditions":[{"expression":"species!=cattle and days_until_replacement<=35 and same_breed","description":"Nachbesetzung"}],"result":{"outcome":"replacement","description":"Nachbesetzung innerhalb von 5 Wochen","value":35},"source_reference_ids":["sr-o65-sheet-p4","sr-o65-srl-p52","sr-o65-srl-p53"],"rego_symbols":["replacement_required","replacement_same_breed"]},
    {"id":"o65-030","rule_type":"replacement_reporting","statement":"Die Nachbesetzung ist innerhalb von 7 Tagen ab Nachbesetzung online an die AMA zu melden.","conditions":[{"expression":"species!=cattle and replacement_reported_within_days<=7","description":"Nachbesetzungsmeldung"}],"result":{"outcome":"replacement_report","description":"AMA-Meldung innerhalb von 7 Tagen","value":7},"source_reference_ids":["sr-o65-sheet-p4","sr-o65-srl-p53"],"rego_symbols":["replacement_report_timely"]},
    {"id":"o65-031","rule_type":"cattle_replacement","statement":"Die Nachbesetzung von Rindern wird automatisch durch die Meldung an die Rinderdatenbank berücksichtigt und muss nicht gemeldet werden.","conditions":[{"expression":"species=cattle","description":"Rinderersatz"}],"result":{"outcome":"automatic_replacement","description":"Keine gesonderte Nachbesetzungsmeldung","value":true},"source_reference_ids":["sr-o65-sheet-p4","sr-o65-srl-p53"],"rego_symbols":["cattle_database_replaces_reports"]},
    {"id":"o65-032","rule_type":"replacement_premium","statement":"Bei Ersatz eines weiblichen Tieres durch ein männliches oder eines Tieres mit Milchleistungskontrolle durch eines ohne wird die geringere Prämie ausbezahlt.","conditions":[{"expression":"female_to_male or milk_control_to_no_control","description":"Prämienmindernder Ersatz"}],"result":{"outcome":"lower_premium","description":"Geringere Prämie anwenden","value":true},"source_reference_ids":["sr-o65-sheet-p4"],"rego_symbols":["replacement_lower_premium_applies"]},
    {"id":"o65-033","rule_type":"breeding_station_transfer","statement":"Der vorübergehende Aufenthalt auf einer Zuchtstation zu Züchtungszwecken ist maximal 6 Monate zulässig.","conditions":[{"expression":"purpose=breeding_station and duration_months<=6","description":"Zuchtstationsaufenthalt"}],"result":{"outcome":"transfer_allowed","description":"Weitergabe zulässig","value":6},"source_reference_ids":["sr-o65-sheet-p5","sr-o65-srl-p53"],"rego_symbols":["breeding_station_transfer_allowed"]},
    {"id":"o65-034","rule_type":"male_breeding_transfer","statement":"Männliche Zuchttiere dürfen für einen vorübergehenden Zuchteinsatz auf einen anderen Betrieb maximal 3 Monate verbracht werden.","conditions":[{"expression":"male and purpose=temporary_breeding_use and duration_months<=3","description":"Vorübergehender Zuchteinsatz"}],"result":{"outcome":"transfer_allowed","description":"Weitergabe zulässig","value":3},"source_reference_ids":["sr-o65-sheet-p5","sr-o65-srl-p53"],"rego_symbols":["male_breeding_transfer_allowed"]},
    {"id":"o65-035","rule_type":"transfer_reporting","statement":"Vor der Weitergabe von Pferden, Schafen, Ziegen oder Schweinen zum Zuchteinsatz ist eine Meldung an die AMA erforderlich.","conditions":[{"expression":"species!=cattle and transfer_duration_days>10","description":"Meldepflichtige Weitergabe"}],"result":{"outcome":"transfer_report","description":"Meldung vor Weitergabe","value":true},"source_reference_ids":["sr-o65-sheet-p5","sr-o65-srl-p53"],"rego_symbols":["transfer_notice_required"]},
    {"id":"o65-036","rule_type":"short_stay_exception","statement":"Bei höchstens 10 Tagen vorübergehender Abwesenheit entfällt die AMA-Meldung, wenn der Aufenthalt belegt werden kann.","conditions":[{"expression":"duration_days<=10 and documented=true","description":"Belegter Kurzaufenthalt"}],"result":{"outcome":"no_transfer_report","description":"Meldung kann entfallen","value":true},"source_reference_ids":["sr-o65-sheet-p5","sr-o65-srl-p53"],"rego_symbols":["transfer_notice_not_required"]},
    {"id":"o65-037","rule_type":"cattle_late_transfer","statement":"Rinder dürfen nach dem 30.09. an andere Betriebe weitergegeben werden, sofern sie nicht vor dem 01.01. des Folgejahres ins Ausland verbracht, geschlachtet werden oder verenden.","conditions":[{"expression":"species=cattle and transfer_date>09-30 and no_early_disqualifying_event","description":"Späte Rinderweitergabe"}],"result":{"outcome":"transfer_allowed","description":"Weitergabe zulässig","value":true},"source_reference_ids":["sr-o65-sheet-p5","sr-o65-srl-p53"],"rego_symbols":[]},
    {"id":"o65-038","rule_type":"gep_surcharge","statement":"Der Zuschlag für ein besonderes Generhaltungsprogramm wird automatisch gewährt, wenn das Programm vom Zuchtverband umgesetzt wird.","conditions":[{"expression":"breed.special_gep=true and program_implemented=true","description":"GEP-Rasse und Umsetzung"}],"result":{"outcome":"gep_surcharge","description":"GEP-Zuschlag gewähren","value":true},"source_reference_ids":["sr-o65-sheet-p5","sr-o65-sheet-p8","sr-o65-annex-p9"],"rego_symbols":["breed_has_gep","premium"]},
    {"id":"o65-039","rule_type":"application_deadline","statement":"Die Maßnahme muss vor Vertragsbeginn im Maßnahmenantrag bis spätestens 31.12. beantragt werden.","conditions":[{"expression":"application_date<=year-1-12-31","description":"Antrag vor Vertragsbeginn"}],"result":{"outcome":"application_on_time","description":"Antragsfrist eingehalten","value":true},"source_reference_ids":["sr-o65-sheet-p5","sr-o65-sheet-p6","sr-o6-general-p12","sr-o6-general-p13"],"rego_symbols":["application_on_time"]},
    {"id":"o65-040","rule_type":"latest_entry","statement":"Der letzte Einstieg in die einjährige Maßnahme ist mit Förderjahr 2027 möglich; die Beantragung dafür muss bis 31.12.2026 erfolgen.","conditions":[{"expression":"year<=2027","description":"Förderjahr des Einstiegs"}],"result":{"outcome":"entry_allowed","description":"Einstieg zulässig","value":2027},"source_reference_ids":["sr-o65-sheet-p6","sr-o6-general-p12"],"rego_symbols":["latest_entry_allowed"]},
    {"id":"o65-041","rule_type":"withdrawal","statement":"Nach Erfüllung des einjährigen Vertragszeitraums ist der Ausstieg möglich; eine Abmeldung vom 01.01. bis 31.12. macht die Maßnahme im betroffenen Förderjahr ungültig.","conditions":[{"expression":"withdrawal_after_contract_year","description":"Ausstieg erst nach Vertragsjahr"}],"result":{"outcome":"withdrawal","description":"Ausstieg zum Folgejahr","value":true},"source_reference_ids":["sr-o65-sheet-p6","sr-o65-sheet-p7","sr-o6-general-p13"],"rego_symbols":[]},
    {"id":"o65-042","rule_type":"2026_holding_exception","statement":"Für das Antragsjahr 2026 ist die Haltedauer nur bis einschließlich 31.08. einzuhalten; ein Abgang ab 01.09. schließt die Prämie nicht aus.","conditions":[{"expression":"year=2026 and held_to>=2026-08-31","description":"Sonderregelung Dürre 2026"}],"result":{"outcome":"holding_requirement","description":"Haltedauer 2026 verkürzt","value":"2026-04-01..2026-08-31"},"source_reference_ids":["sr-2026-08-12-o65"],"rego_symbols":["holding_deadline","holding_valid"]},
    {"id":"o65-043","rule_type":"2026_movement_reporting","statement":"Die vorgeschriebenen Meldungen zu Tierbewegungen müssen 2026 bis Jahresende weiterhin erfolgen.","conditions":[{"expression":"year=2026 and non_cattle_movement","description":"Tierbewegung im Jahr 2026"}],"result":{"outcome":"movement_report","description":"Meldung bleibt bis Jahresende erforderlich","value":true},"source_reference_ids":["sr-2026-08-12-o65"],"rego_symbols":["movement_report_required"]},
    {"id":"o65-044","rule_type":"2026_replacement_reporting_exception","statement":"Für 2026 ist die Meldung von Nachbesetzungen nach dem 31.08. nicht mehr erforderlich.","conditions":[{"expression":"year=2026 and replacement_date>2026-08-31","description":"Nachbesetzung nach Ende der verkürzten Haltedauer"}],"result":{"outcome":"no_replacement_report","description":"Keine Nachbesetzungsmeldung nach 31. August","value":true},"source_reference_ids":["sr-2026-08-12-o65"],"rego_symbols":["replacement_report_required"]},
    {"id":"o65-045","rule_type":"premium_schedule","statement":"Die Prämie wird je Tier nach Tierkategorie, Prämienstufe, GEP und bei Kühen Milchleistungskontrolle berechnet; die vollständigen Sätze stehen in data/o6_5_tables.json.","conditions":[{"expression":"animal_type and premium_tier and year","description":"Prämienparameter"}],"result":{"outcome":"premium_eur_per_animal","description":"Tabellenwert plus zutreffende Zuschläge","value":null},"source_reference_ids":["sr-o65-sheet-p7","sr-o65-sheet-p8","sr-o65-srl-p53"],"rego_symbols":["premium","premium_rows"]},
    {"id":"o65-046","rule_type":"breed_list","statement":"Die förderfähigen Rassen, Prämienstufen, GEP-Kennzeichen und zuständigen Zuchtorganisationen entsprechen vollständig der Rassenliste.","conditions":[{"expression":"breed_record(animal)","description":"Rassenlistenabgleich"}],"result":{"outcome":"breed_list_data","description":"Geschlossene Rassenliste aus data/o6_5_tables.json","value":null},"source_reference_ids":["sr-o65-sheet-p8","sr-o65-sheet-p9","sr-o65-annex-p9"],"rego_symbols":["breed_record"]},
    {"id":"o65-047","rule_type":"gep_requirements","statement":"Für GEP-Rassen gelten zusätzlich Abstammungssicherung, gezielte Paarung nach Anpaarungsplan, genetische Arbeitskollektion/Genbanknutzung, Erbfehlermanagement und vertieftes Vatertiermonitoring.","conditions":[{"expression":"breed.special_gep=true","description":"Besonderes Generhaltungsprogramm"}],"result":{"outcome":"gep_requirements","description":"Vollständige GEP-Anforderungsliste aus data/o6_5_tables.json","value":null},"source_reference_ids":["sr-o65-annex-p9"],"rego_symbols":[]},
    {"id":"o65-048","rule_type":"location","statement":"Geförderte Tiere müssen in Österreich gehalten werden; außerhalb Österreichs gehaltene Tiere werden nicht berücksichtigt.","conditions":[{"expression":"animal.holding_country=Austria","description":"Inländischer Haltungsort"}],"result":{"outcome":"location_requirement","description":"Tier ist standortbezogen förderfähig","value":true},"source_reference_ids":["sr-o6-general-p9"],"rego_symbols":[]},
    {"id":"o65-049","rule_type":"farm_minimum_size","statement":"Im ersten ÖPUL-Teilnahmejahr muss der Betrieb mindestens 0,50 ha geschützten Anbau oder 1,50 ha landwirtschaftliche Fläche zuzüglich der genannten Zuschlagsflächen bewirtschaften.","conditions":[{"expression":"first_participation and (protected_area>=0.5 or eligible_area>=1.5)","description":"Betriebsmindestgröße"}],"result":{"outcome":"farm_size_requirement","description":"Betriebsmindestgröße erfüllt","value":true},"source_reference_ids":["sr-o6-general-p5","sr-o6-general-p10"],"rego_symbols":[]},
    {"id":"o65-050","rule_type":"conditionality","statement":"ÖPUL-Teilnehmer müssen die Konditionalitätsbestimmungen einhalten, um die Förderung in voller Höhe zu erhalten.","conditions":[{"expression":"conditionality_compliant","description":"Konditionalität"}],"result":{"outcome":"full_payment_condition","description":"Förderung in voller Höhe möglich","value":true},"source_reference_ids":["sr-o6-general-p4"],"rego_symbols":[]},
    {"id":"o65-051","rule_type":"sanction","statement":"Verstöße können je nach Schwere, Ausmaß, Dauer und Häufigkeit von Verwarnung bis 100 % Kürzung sowie bei zweimaliger 100 %-Kürzung zum Ausschluss und zur Rückforderung führen.","conditions":[{"expression":"noncompliance","description":"Festgestellter Verstoß"}],"result":{"outcome":"sanction","description":"Maßnahmenbezogene Kürzung oder Ausschluss","value":["warning","2%","5%","10%","25%","50%","100%","exclusion_and_recovery"]},"source_reference_ids":["sr-o6-general-p17","sr-o6-general-p18"],"rego_symbols":[]},
    {"id":"o65-052","rule_type":"payment","statement":"Die Förderung wird als jährliche Prämie gewährt; Auszahlung erfolgt bis 30.06. des Folgejahres, eine Teilzahlung bis maximal 75 % ist möglich.","conditions":[{"expression":"approved_and_controlled","description":"Bewilligung und Verwaltungskontrolle"}],"result":{"outcome":"annual_payment","description":"Jährliche Zahlung und mögliche Teilzahlung","value":{"payment_deadline":"06-30","advance_max_percent":75}},"source_reference_ids":["sr-o6-general-p18","sr-o6-srl-p22"],"rego_symbols":[]},
    {"id":"o65-053","rule_type":"measure_transfer","statement":"Eine Übernahme von o6_5 ist nur in Einzelfällen im Zuge einer Betriebsauflösung, Betriebsteilung oder Betriebszusammenlegung möglich; Tiere und Flächen müssen vom selben Vorbetrieb stammen.","conditions":[{"expression":"transfer_case in [closure,division,merger] and same_predecessor","description":"Sonderregel für tierbezogene Maßnahmenübernahme"}],"result":{"outcome":"transfer_allowed_only_exceptionally","description":"AMA-Genehmigung im Einzelfall erforderlich","value":true},"source_reference_ids":["sr-o6-general-p14","sr-o6-general-p15","sr-o6-srl-p14"],"rego_symbols":[]},
    {"id":"o65-054","rule_type":"control","statement":"Die Einhaltung der Bedingungen wird durch Verwaltungs-, Vor-Ort- und nachgängige Kontrollen geprüft; falsche Tieranzahlen können Kürzungen auslösen.","conditions":[{"expression":"control_relevant","description":"Kontrolle der Tierangaben und Verpflichtungen"}],"result":{"outcome":"control_and_reduction","description":"Kontrolle und mögliche Kürzung/Rückforderung","value":true},"source_reference_ids":["sr-o6-general-p17","sr-o6-general-p18"],"rego_symbols":[]},
