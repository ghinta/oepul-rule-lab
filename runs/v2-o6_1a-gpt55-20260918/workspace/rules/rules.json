{
  "contract_version": "rules-catalog-v2.0.0",
  "measure": "o6_1a",
  "rules": [
    {
      "id": "O6_1A.CONTRACT.PERIOD",
      "rule_type": "eligibility",
      "statement": "UBB läuft als mehrjährige Maßnahme bis 31.12.2028; optionale Zuschläge laufen kalenderjährig.",
      "conditions": [
        {
          "expression": "measure=o6_1a",
          "description": "UBB beantragt",
          "input_paths": [
            "farm.oepul_participation"
          ]
        }
      ],
      "result": {
        "outcome": "requirement",
        "description": "Vertragsdauer und Optionsdauer sind einzuhalten."
      },
      "source_reference_ids": [
        "SRC.UBB.3.1",
        "SRC.GEN.5.9"
      ]
    },
    {
      "id": "O6_1A.ELIGIBLE_SURFACE.SCOPE",
      "rule_type": "eligibility",
      "statement": "Förderverpflichtungen beziehen sich auf Acker- und Grünlandflächen sowie punktförmige Landschaftselemente und Mehrnutzenhecken.",
      "conditions": [
        {
          "expression": "unit type in scope",
          "description": "Einheit liegt im Maßnahmenumfang",
          "input_paths": [
            "land.parcels[]"
          ]
        }
      ],
      "result": {
        "outcome": "eligible",
        "description": "Nur Einheiten im Maßnahmenumfang können UBB-relevant sein."
      },
      "source_reference_ids": [
        "SRC.UBB.3.2",
        "SRC.SRL.2.1A"
      ]
    },
    {
      "id": "O6_1A.APPLICANT.ACTIVE_FARMER",
      "rule_type": "eligibility",
      "statement": "Förderwerbende müssen einen landwirtschaftlichen Betrieb im eigenen Namen und auf eigene Rechnung bewirtschaften und Verfügungsgewalt über beantragte Flächen haben.",
      "conditions": [
        {
          "expression": "active_farmer and disposal_power",
          "description": "Allgemeine Fördervoraussetzung erfüllt",
          "input_paths": [
            "farm.active_farmer",
            "land.parcels[].disposal_power"
          ]
        }
      ],
      "result": {
        "outcome": "eligible",
        "description": "Ohne allgemeine Voraussetzung keine Förderung."
      },
      "source_reference_ids": [
        "SRC.GEN.5.2"
      ]
    },
    {
      "id": "O6_1A.FARM_MIN_SIZE.FIRST_YEAR",
      "rule_type": "eligibility",
      "statement": "Im ersten ÖPUL-Teilnahmejahr sind mindestens 0,50 ha geschützter Anbau oder 1,50 ha anrechenbare landwirtschaftliche Fläche erforderlich.",
      "conditions": [
        {
          "expression": "first_year implies protected>=0.5 or eligible_area>=1.5",
          "description": "Betriebsmindestgröße erfüllt",
          "input_paths": [
            "land.protected_cultivation_area_ha",
            "land.eligible_agricultural_area_ha"
          ]
        }
      ],
      "result": {
        "outcome": "eligible",
        "description": "Mindestgröße im ersten Teilnahmejahr."
      },
      "source_reference_ids": [
        "SRC.GEN.5.3"
      ]
    },
    {
      "id": "O6_1A.LIVESTOCK.CLASSIFICATION",
      "rule_type": "classification",
      "statement": "Tierhaltender Betrieb ab mindestens 0,30 RGVE je ha Futterfläche; RGVE-Faktoren sind gemäß Tabelle anzuwenden.",
      "conditions": [
        {
          "expression": "rgve_total / forage_area >= 0.30",
          "description": "Schwelle erreicht",
          "input_paths": [
            "livestock.species_groups[]",
            "land.parcels[]"
          ]
        }
      ],
      "result": {
        "outcome": "classify",
        "description": "Tierhalterstatus bestimmt Grünland-Basismodulprämie."
      },
      "source_reference_ids": [
        "SRC.UBB.4",
        "SRC.UBB.12",
        "SRC.ANH.A"
      ],
      "rego_symbols": [
        "classification",
        "is_livestock_holding"
      ]
    },
    {
      "id": "O6_1A.GRASSLAND_RETENTION.MAX_CONVERSION_1HA",
      "rule_type": "obligation",
      "statement": "Grünlandausmaß ist im Vertragszeitraum zu erhalten; netto maximal 1,00 ha Umwandlung ist zulässig, Neuanlagen und innerbetriebliche Zug-um-Zug-Tausche werden berücksichtigt.",
      "conditions": [
        {
          "expression": "converted - newly_established <= 1.0",
          "description": "Toleranz eingehalten",
          "input_paths": [
            "land.grassland_converted_ha_contract_period",
            "land.grassland_newly_established_ha_contract_period"
          ]
        }
      ],
      "result": {
        "outcome": "compliant",
        "description": "Überschreitung verletzt Grünlanderhalt."
      },
      "source_reference_ids": [
        "SRC.UBB.5.1"
      ],
      "rego_symbols": [
        "violations"
      ]
    },
    {
      "id": "O6_1A.ARABLE_DIVERSIFICATION.CEREAL_MAIZE_MAX_75",
      "rule_type": "obligation",
      "statement": "Bei mehr als 5,00 ha Ackerfläche sind maximal 75 % Getreide und Mais zulässig.",
      "conditions": [
        {
          "expression": "arable_area > 5",
          "description": "Pflicht ausgelöst",
          "input_paths": [
            "land.arable_area_ha"
          ]
        },
        {
          "expression": "(cereal_area + maize_area)/arable_area <= 0.75",
          "description": "Grenze eingehalten",
          "input_paths": [
            "land.parcels[]"
          ]
        }
      ],
      "result": {
        "outcome": "compliant",
        "description": "Überschreitung ist Verstoß."
      },
      "source_reference_ids": [
        "SRC.UBB.5.2",
        "SRC.UBB.5.2.DEF"
      ],
      "rego_symbols": [
        "violations"
      ]
    },
    {
      "id": "O6_1A.ARABLE_DIVERSIFICATION.SINGLE_CROP_MAX_55",
      "rule_type": "obligation",
      "statement": "Bei mehr als 5,00 ha Ackerfläche darf keine Kultur mehr als 55 % der Ackerfläche haben; ausgenommen Ackerfutter sowie ab 2025 Grünbrache und Spargel.",
      "conditions": [
        {
          "expression": "arable_area > 5",
          "description": "Pflicht ausgelöst",
          "input_paths": [
            "land.arable_area_ha"
          ]
        },
        {
          "expression": "crop_share <= 0.55 or crop exempt",
          "description": "Grenze oder Ausnahme erfüllt",
          "input_paths": [
            "land.parcels[].crop.crop_name"
          ]
        }
      ],
      "result": {
        "outcome": "compliant",
        "description": "Überschreitung ist Verstoß."
      },
      "source_reference_ids": [
        "SRC.UBB.5.2",
        "SRC.UBB.5.2.DEF"
      ],
      "rego_symbols": [
        "violations"
      ]
    },
    {
      "id": "O6_1A.TRAINING.BIODIVERSITY_3H_BY_2025",
      "rule_type": "obligation",
      "statement": "Bis 31.12.2025 sind mindestens 3 Stunden biodiversitätsrelevante Weiterbildung bei anerkanntem Anbieter zu absolvieren; Anrechnung ab 01.01.2022, keine Doppelanrechnung.",
      "conditions": [
        {
          "expression": "year>=2026 implies hours>=3",
          "description": "Frist erfüllt",
          "input_paths": [
            "farm.year",
            "documentation.biodiversity_training_hours_since_2022"
          ]
        }
      ],
      "result": {
        "outcome": "compliant",
        "description": "Fehlende Stunden sind Verstoß."
      },
      "source_reference_ids": [
        "SRC.UBB.5.3"
      ],
      "rego_symbols": [
        "violations"
      ]
    },
    {
      "id": "O6_1A.ARABLE_BIODIVERSITY.MIN_7_PERCENT",
      "rule_type": "obligation",
      "statement": "Ab mehr als 2,00 ha Ackerfläche sind mindestens 7 % Acker-DIV oder anrechenbare Flächen anzulegen; unter 10 ha Acker kann die Pflicht durch zusätzliche Grünland-DIV erfüllt werden.",
      "conditions": [
        {
          "expression": "arable_area > 2",
          "description": "Pflicht ausgelöst",
          "input_paths": [
            "land.arable_area_ha"
          ]
        },
        {
          "expression": "credit_area >= 0.07*arable_area",
          "description": "Mindestausmaß erfüllt",
          "input_paths": [
            "land.parcels[]"
          ]
        }
      ],
      "result": {
        "outcome": "compliant",
        "description": "Unterschreitung ist Verstoß; unter 2 ha freiwillig prämienfähig."
      },
      "source_reference_ids": [
        "SRC.UBB.6.1"
      ],
      "rego_symbols": [
        "violations"
      ]
    },
    {
      "id": "O6_1A.ARABLE_FIELD_BLOCK.MIN_0_15HA",
      "rule_type": "obligation",
      "statement": "Ab 10,00 ha Acker am Betrieb sind auf Acker-Feldstücken über 5,00 ha mindestens 0,15 ha Biodiversitäts- oder anrechenbare Flächen anzulegen; GLÖZ-LSE und ab 2025 Agroforststreifen zählen nur hierfür, nicht für 7 %.",
      "conditions": [
        {
          "expression": "arable_area>=10 and field_block.area>5",
          "description": "Pflicht ausgelöst",
          "input_paths": [
            "land.field_blocks[]"
          ]
        },
        {
          "expression": "field_block.biodiversity_credit_area_ha>=0.15",
          "description": "Mindestfläche erreicht",
          "input_paths": [
            "land.field_blocks[]"
          ]
        }
      ],
      "result": {
        "outcome": "compliant",
        "description": "Unterschreitung ist Verstoß."
      },
      "source_reference_ids": [
        "SRC.UBB.6.1.2"
      ],
      "rego_symbols": [
        "violations"
      ]
    },
    {
      "id": "O6_1A.ARABLE_BIODIVERSITY.CREDITABLE_SURFACES",
      "rule_type": "crediting",
      "statement": "Als Acker-DIV anrechenbar sind bei Zusatzcode DIV und Auflagenerfüllung u. a. NAT/EBW-Ackerstilllegung, Mehrnutzenhecken, BAW, AG, GLÖZ-4-Pufferstreifen und bis 2024 GLÖZ-8-Stilllegung; K20-Ackerflächen sind nicht anrechenbar.",
      "conditions": [
        {
          "expression": "eligible code and management conditions",
          "description": "Anrechnungsvoraussetzung erfüllt",
          "input_paths": [
            "land.parcels[].codes"
          ]
        }
      ],
      "result": {
        "outcome": "credit",
        "description": "Fläche zählt zur Acker-DIV-Mindestanlage."
      },
      "source_reference_ids": [
        "SRC.UBB.6.1.3"
      ],
      "rego_symbols": [
        "arable_biodiversity_credit_area"
      ]
    },
    {
      "id": "O6_1A.ARABLE_BIODIVERSITY.SEED_MIX",
      "rule_type": "obligation",
      "statement": "Acker-DIV benötigt grundsätzlich Neuansaat mit mindestens 7 insektenblütigen Mischungspartnern aus mindestens 3 Pflanzenfamilien und maximal 10 % nicht insektenblütigen Partnern; definierte Altflächen sind ausgenommen.",
      "conditions": [
        {
          "expression": "seed_mix meets counts or legacy exemption",
          "description": "Saatgutauflage erfüllt",
          "input_paths": [
            "land.parcels[].constraints.biodiversity_area.seed_mix"
          ]
        }
      ],
      "result": {
        "outcome": "compliant",
        "description": "Abweichung ist Verstoß."
      },
      "source_reference_ids": [
        "SRC.UBB.6.1.4.1"
      ],
      "rego_symbols": [
        "violations"
      ]
    },
    {
      "id": "O6_1A.ARABLE_BIODIVERSITY.SOWING_TWO_YEAR",
      "rule_type": "obligation",
      "statement": "Acker-DIV-Neuansaat bis 15. Mai; Umbruch frühestens am 15. September des zweiten Jahres, bei Winterung/Zwischenfrucht nach 31. Juli; mindestens zwei Mehrfachanträge lagegenau.",
      "conditions": [
        {
          "expression": "sowing_date<=05-15 and commitment_years>=2",
          "description": "Fristen/Zweijährigkeit erfüllt",
          "input_paths": [
            "land.parcels[].constraints.biodiversity_area"
          ]
        }
      ],
      "result": {
        "outcome": "compliant",
        "description": "Zu späte Ansaat oder vorzeitiger Umbruch ist Verstoß."
      },
      "source_reference_ids": [
        "SRC.UBB.6.1.4.1"
      ],
      "rego_symbols": [
        "violations"
      ]
    },
    {
      "id": "O6_1A.ARABLE_BIODIVERSITY.USE_RULES",
      "rule_type": "obligation",
      "statement": "Acker-DIV ist ab 2025 mindestens einmal jedes zweite Jahr zu mähen/häckseln/beweiden, höchstens zweimal jährlich; auf 75 % frühestens ab 1. August, Beweidung generell erst ab 1. August; Problemarten können frühere/häufigere Mahd rechtfertigen.",
      "conditions": [
        {
          "expression": "use_count<=2 and early_use within 25% unless exception",
          "description": "Nutzungsauflagen erfüllt",
          "input_paths": [
            "land.parcels[].operations"
          ]
        }
      ],
      "result": {
        "outcome": "compliant",
        "description": "Nutzung außerhalb Grenzen ist Verstoß."
      },
      "source_reference_ids": [
        "SRC.UBB.6.1.4.2"
      ],
      "rego_symbols": [
        "violations"
      ]
    },
    {
      "id": "O6_1A.ARABLE_BIODIVERSITY.NO_INPUTS_MECHANICAL",
      "rule_type": "obligation",
      "statement": "Auf Acker-DIV sind PSM und jegliche Düngung vom ersten DIV-Jahr bis Umbruch/anderer Deklaration verboten; nur Bio-VO-PSM sind zulässig und Beseitigung nur mechanisch.",
      "conditions": [
        {
          "expression": "no fertilizer and no non-bio psm and mechanical removal",
          "description": "Betriebsmittel-/Beseitigungsauflage erfüllt",
          "input_paths": [
            "land.parcels[].operations"
          ]
        }
      ],
      "result": {
        "outcome": "compliant",
        "description": "Unzulässige Mittel oder Beseitigung sind Verstoß."
      },
      "source_reference_ids": [
        "SRC.UBB.6.1.4.3"
      ],
      "rego_symbols": [
        "violations"
      ]
    },
    {
      "id": "O6_1A.ARABLE_BIODIVERSITY.NO_DRIVING",
      "rule_type": "obligation",
      "statement": "Acker-DIV darf nicht befahren oder als Beregnungs-, Abstell-, Lager- oder Wendefläche verwendet werden; bloßes Überqueren zum Erreichen angrenzender Kulturen ist zulässig.",
      "conditions": [
        {
          "expression": "no prohibited driving/storage/turning",
          "description": "Befahrensauflage erfüllt",
          "input_paths": [
            "land.parcels[].operations"
          ]
        }
      ],
      "result": {
        "outcome": "compliant",
        "description": "Unzulässige Nutzung ist Verstoß."
      },
      "source_reference_ids": [
        "SRC.UBB.6.1.4.4"
      ]
    },
    {
      "id": "O6_1A.ARABLE_DIVRS.CONDITIONS",
      "rule_type": "premium_condition",
      "statement": "Acker-DIVRS-Zuschlag bis 20 % Ackerfläche setzt 30 Arten aus 7 Familien der Artenliste, 20 kg/ha, maximal 5 Gewichtsprozent je Art, regionale Herkunftsnachweise, Saatgutetiketten/Bezugsrechnungen und besondere Pflegevarianten voraus.",
      "conditions": [
        {
          "expression": "DIVRS and seed/use/documentation conditions",
          "description": "Zuschlagsvoraussetzungen erfüllt",
          "input_paths": [
            "land.parcels[].codes",
            "documentation.seed_and_cultivar_records"
          ]
        }
      ],
      "result": {
        "outcome": "eligible_for_premium",
        "description": "Zuschlag nach Variante Sonstiges Feldfutter oder Grünbrache."
      },
      "source_reference_ids": [
        "SRC.UBB.6.1.5",
        "SRC.UBB.14",
        "SRC.ANH.C"
      ],
      "rego_symbols": [
        "violations"
      ]
    },
    {
      "id": "O6_1A.GRASSLAND_BIODIVERSITY.MIN_7_PERCENT",
      "rule_type": "obligation",
      "statement": "Ab mehr als 2,00 ha gemähter Grünlandfläche ohne Bergmähder sind mindestens 7 % Grünland-DIV oder anrechenbare Flächen anzulegen; unter 2 ha freiwillig prämienfähig.",
      "conditions": [
        {
          "expression": "mown_grassland>2",
          "description": "Pflicht ausgelöst",
          "input_paths": [
            "land.mown_grassland_area_excluding_mountain_meadows_ha"
          ]
        },
        {
          "expression": "credit_area>=0.07*mown_grassland",
          "description": "Mindestausmaß erfüllt",
          "input_paths": [
            "land.parcels[]"
          ]
        }
      ],
      "result": {
        "outcome": "compliant",
        "description": "Unterschreitung ist Verstoß."
      },
      "source_reference_ids": [
        "SRC.UBB.6.2"
      ],
      "rego_symbols": [
        "violations"
      ]
    },
    {
      "id": "O6_1A.GRASSLAND_FIELD_BLOCK.MIN_0_15HA",
      "rule_type": "obligation",
      "statement": "Ab 10,00 ha gemähter Grünlandfläche sind auf Grünland-Feldstücken mit mehr als 5,00 ha gemähten Flächen mindestens 0,15 ha anrechenbare Biodiversitätsfläche anzulegen; GLÖZ-LSE zählen nur für diese Pflicht.",
      "conditions": [
        {
          "expression": "mown_grassland>=10 and block.mown_area>5",
          "description": "Pflicht ausgelöst",
          "input_paths": [
            "land.field_blocks[]"
          ]
        },
        {
          "expression": "block.biodiversity_credit_area_ha>=0.15",
          "description": "Mindestfläche erreicht",
          "input_paths": [
            "land.field_blocks[]"
          ]
        }
      ],
      "result": {
        "outcome": "compliant",
        "description": "Unterschreitung ist Verstoß."
      },
      "source_reference_ids": [
        "SRC.UBB.6.2"
      ],
      "rego_symbols": [
        "violations"
      ]
    },
    {
      "id": "O6_1A.GRASSLAND_BIODIVERSITY.CREDITABLE_SURFACES",
      "rule_type": "crediting",
      "statement": "Grünlandflächen aus Naturschutz, Ergebnisorientierter Bewirtschaftung und Natura 2000/andere Schutzgebiete sind bei Schnittzeitpunkt-/Lebensraumauflage und entsprechendem DIV-Code anrechenbar; Projektbestätigung bleibt maßgeblich.",
      "conditions": [
        {
          "expression": "NAT/EBW/N2 with project confirmation",
          "description": "Anrechenbarkeit erfüllt",
          "input_paths": [
            "land.parcels[].codes"
          ]
        }
      ],
      "result": {
        "outcome": "credit",
        "description": "Fläche zählt zur Grünland-DIV-Mindestanlage."
      },
      "source_reference_ids": [
        "SRC.UBB.6.2",
        "SRC.UBB.6.2.4"
      ]
    },
    {
      "id": "O6_1A.GRASSLAND_BIODIVERSITY.BASE_MANAGEMENT",
      "rule_type": "obligation",
      "statement": "Auf Grünland-DIV sind PSM verboten außer Bio-VO-Wirkstoffe; bei jeder Variante ist jährlich mindestens eine Mahd mit Verbringung des Mähguts erforderlich.",
      "conditions": [
        {
          "expression": "no non-bio psm and annual mowing with removal",
          "description": "Grundauflagen erfüllt",
          "input_paths": [
            "land.parcels[].operations"
          ]
        }
      ],
      "result": {
        "outcome": "compliant",
        "description": "Abweichung ist Verstoß."
      },
      "source_reference_ids": [
        "SRC.UBB.6.2.4"
      ],
      "rego_symbols": [
        "violations"
      ]
    },
    {
      "id": "O6_1A.GRASSLAND_DIVSZ.RULES",
      "rule_type": "obligation",
      "statement": "DIVSZ: erste Nutzung frühestens mit zweiter Mahd vergleichbarer Schläge oder als einmähdige Wiese, frühestens 15. Juni, jedenfalls ab 15. Juli, phänologisch bis 10 Tage früher; keine Düngung vor erster Nutzung; Häckseln erst nach erster Nutzung.",
      "conditions": [
        {
          "expression": "variant=DIVSZ implies date/fertilizer/mulch conditions",
          "description": "DIVSZ erfüllt",
          "input_paths": [
            "land.parcels[].constraints.biodiversity_area.variant_code",
            "land.parcels[].operations.first_use_date"
          ]
        }
      ],
      "result": {
        "outcome": "compliant",
        "description": "Abweichung ist Verstoß."
      },
      "source_reference_ids": [
        "SRC.UBB.6.2.4.1"
      ],
      "rego_symbols": [
        "violations"
      ]
    },
    {
      "id": "O6_1A.GRASSLAND_DIVNFZ.RULES",
      "rule_type": "obligation",
      "statement": "DIVNFZ: nach erster Nutzung mindestens 9 Wochen/63 Tage nutzungsfrei, kein Befahren und keine Düngung, zweite Nutzung jedenfalls erforderlich; Dokumentationspflicht entfällt ab 2025.",
      "conditions": [
        {
          "expression": "variant=DIVNFZ implies free_days>=63 and second_use",
          "description": "DIVNFZ erfüllt",
          "input_paths": [
            "land.parcels[].operations.use_free_period_days_after_first_use"
          ]
        }
      ],
      "result": {
        "outcome": "compliant",
        "description": "Abweichung ist Verstoß."
      },
      "source_reference_ids": [
        "SRC.UBB.6.2.4.2"
      ],
      "rego_symbols": [
        "violations"
      ]
    },
    {
      "id": "O6_1A.GRASSLAND_DIVAGF.RULES",
      "rule_type": "obligation",
      "statement": "DIVAGF: Altgras über Winter, letzte Nutzung bis 15. August, danach bis Folgejahresnutzung kein Befahren/Düngen; im Folgejahr lagegenau DIVSZ, außer Verlust der Verfügungsgewalt.",
      "conditions": [
        {
          "expression": "variant=DIVAGF implies last_use<=08-15 and next_year_divsz",
          "description": "DIVAGF erfüllt",
          "input_paths": [
            "land.parcels[].operations.last_use_date"
          ]
        }
      ],
      "result": {
        "outcome": "compliant",
        "description": "Abweichung ist Verstoß."
      },
      "source_reference_ids": [
        "SRC.UBB.6.2.4.3"
      ],
      "rego_symbols": [
        "violations"
      ]
    },
    {
      "id": "O6_1A.GRASSLAND_DIVRS.CONDITIONS",
      "rule_type": "premium_condition",
