{
  "contract_version": "profile-changes-v1.0.0",
  "run_id": "v2-o6_2-luna-high-20260930",
  "measure": "o6_2",
  "changes": [
    {
      "action": "add",
      "path": "year",
      "value_after": "int",
      "rationale": "The evaluator needs the current contract/application year at the profile root.",
      "rule_ids": ["O62-R02", "O62-R15", "O62-R25", "O62-R37"],
      "source_reference_ids": ["O62-02", "O62-15", "O62-23", "NOTICE-0805-01"]
    },
    {
      "action": "add",
      "path": "application_year",
      "value_after": "int",
      "rationale": "The evaluator needs the funding year for the premium schedule and 2026 exceptions.",
      "rule_ids": ["O62-R15", "O62-R25", "O62-R37"],
      "source_reference_ids": ["O62-15", "O62-26", "NOTICE-0805-01"]
    },
    {
      "action": "add",
      "path": "farm.measures",
      "value_after": [
        {
          "measure": "o6_2",
          "participates": "boolean",
          "contract_start_year": "int|null",
          "application_year": "int|null",
          "application_date": "date|null"
        }
      ],
      "rationale": "Participation and application state must be represented as a list of measure records.",
      "rule_ids": ["O62-R02", "O62-R03", "O62-R21", "O62-R23"],
      "source_reference_ids": ["O62-02", "O62-03", "O62-22", "O62-23", "O62-25"]
    },
    {
      "action": "add",
      "path": "farm.input_inventory",
      "value_after": [
        {
          "input_type": "string",
          "crop_scope": "string|null",
          "quantity": "number|null",
          "is_prohibited": "boolean",
          "documentation_complete": "boolean"
        }
      ],
      "rationale": "The purchase and storage rule needs an inventory record for inputs and supporting documentation.",
      "rule_ids": ["O62-R16"],
      "source_reference_ids": ["O62-16"]
    },
    {
      "action": "add",
      "path": "farm.payment_components",
      "value_after": [
        {
          "component": "string",
          "amount_eur_per_ha": "number"
        }
      ],
      "rationale": "Payment components are needed for the payment cap and modulation calculations.",
      "rule_ids": ["O62-R29", "O62-R35", "O62-R36"],
      "source_reference_ids": ["O62-29", "GEN-12", "GEN-13"]
    },
    {
      "action": "add",
      "path": "farm.compliance",
      "value_after": {
        "external_n_fertilizer_kg": "number",
        "livestock_n_kg_per_ha": "number",
        "purchase_storage_records_complete": "boolean"
      },
      "rationale": "The farm-wide nitrogen and purchase/storage compliance results are not in the canonical profile.",
      "rule_ids": ["O62-R07", "O62-R11", "O62-R16"],
      "source_reference_ids": ["O62-06", "O62-11", "O62-16"]
    },
    {
      "action": "add",
      "path": "farm.training",
      "value_after": {
        "hours": "number",
        "course_date": "date|null",
        "completed_by": "date|null",
        "provider_approved": "boolean",
        "double_counted": "boolean",
        "trained_person_departure_date": "date|null",
        "biodiversity_hours": "number"
      },
      "rationale": "Training duration, dates, provider, continuity, double counting and the additional UBB training must be represented.",
      "rule_ids": ["O62-R17", "O62-R18", "O62-R19", "O62-R20"],
      "source_reference_ids": ["O62-17", "O62-18-TXT", "O62-19", "O62-20", "O62-21"]
    },
    {
      "action": "add",
      "path": "farm.forage_area_ha",
      "value_after": "number",
      "rationale": "Animal status is calculated per hectare of the combined grassland and arable-fodder area.",
      "rule_ids": ["O62-R04", "O62-R26", "O62-R27", "O62-R28"],
      "source_reference_ids": ["O62-04", "O62-05", "O62-27", "O62-28"]
    },
    {
      "action": "add",
      "path": "livestock.species_groups[].category_code",
      "value_after": "string|null",
      "rationale": "A stable category code can identify the age, size and breed class in the complete RGVE table.",
      "rule_ids": ["O62-R04", "O62-R06", "O62-R30"],
      "source_reference_ids": ["ANN-A-01", "ANN-A-02", "GEN-03"]
    },
    {
      "action": "add",
      "path": "livestock.species_groups[].holding_country",
      "value_after": "string",
      "rationale": "The location of the production unit is needed to restrict counted animals to eligible Austrian holdings.",
      "rule_ids": ["O62-R30"],
      "source_reference_ids": ["GEN-03"]
    },
    {
      "action": "add",
      "path": "land.parcels[].code",
      "value_after": "string|null",
      "rationale": "The parcel operation code is needed for the biodiversity-area exceptions.",
      "rule_ids": ["O62-R38", "O62-R39"],
      "source_reference_ids": ["NOTICE-0522-01", "NOTICE-0522-02"]
    },
    {
      "action": "add",
      "path": "land.parcels[].late_summer_or_autumn_harvest_crop",
      "value_after": "boolean",
      "rationale": "The 2026 drought exception applies only to the specified late-summer or autumn harvest crops.",
      "rule_ids": ["O62-R37"],
      "source_reference_ids": ["NOTICE-0805-01", "NOTICE-0805-02"]
    },
    {
      "action": "add",
      "path": "land.parcels[].no_harvestable_stand_due_to_drought",
      "value_after": "boolean",
      "rationale": "The drought exception requires that no harvestable stand exists due to drought.",
      "rule_ids": ["O62-R37"],
      "source_reference_ids": ["NOTICE-0805-01"]
    },
    {
      "action": "add",
      "path": "land.parcels[].combined_area_payments_eur_per_ha",
      "value_after": "number|null",
      "rationale": "The combined-payment amount is required to apply the 1,300 euro per hectare cap.",
      "rule_ids": ["O62-R35"],
      "source_reference_ids": ["GEN-12"]
    },
    {
      "action": "add",
      "path": "land.parcels[].crop.planting_material_quality",
      "value_after": "string|null",
      "rationale": "The orchard premium requires a quality classification of the planting material.",
      "rule_ids": ["O62-R24"],
      "source_reference_ids": ["O62-26"]
    },
    {
      "action": "add",
      "path": "land.parcels[].crop.second_crop",
      "value_after": "boolean",
      "rationale": "The second-crop status affects the o6_2 premium classification.",
      "rule_ids": ["O62-R29"],
      "source_reference_ids": ["O62-29"]
    },
    {
      "action": "add",
      "path": "land.parcels[].operations.seed_treatment",
      "value_after": "boolean",
      "rationale": "Seed treatment is tested as a form of broad plant-protection application on restricted areas.",
      "rule_ids": ["O62-R13"],
      "source_reference_ids": ["O62-13"]
    },
    {
      "action": "add",
      "path": "land.parcels[].operations.psm_applications",
      "value_after": [
        {
          "bio_allowed": "boolean",
          "individual_plant_treatment": "boolean",
          "broad_application": "boolean"
        }
      ],
      "rationale": "Each restricted parcel needs a representative list of plant-protection applications to test the permitted exceptions.",
      "rule_ids": ["O62-R12", "O62-R13", "O62-R14"],
      "source_reference_ids": ["O62-12", "O62-13", "O62-14"]
    },
    {
      "action": "add",
      "path": "land.parcels[].operations.fertilizer.source",
      "value_after": "string",
      "rationale": "The fertilizer exception and prohibition rules classify the source of each fertilizer input.",
      "rule_ids": ["O62-R08", "O62-R09", "O62-R10"],
      "source_reference_ids": ["O62-07", "O62-08", "O62-09", "O62-10"]
    },
    {
      "action": "add",
      "path": "land.measure_area_current_year",
      "value_after": "number",
      "rationale": "The current-year measure area is needed for area access and payment calculations.",
      "rule_ids": ["O62-R25", "O62-R29", "O62-R32", "O62-R33"],
      "source_reference_ids": ["O62-26", "O62-29", "GEN-09", "GEN-10"]
    },
    {
      "action": "add",
      "path": "land.measure_area_previous_year",
      "value_after": "number",
      "rationale": "The previous-year measure area is needed to assess annual area changes.",
      "rule_ids": ["O62-R32", "O62-R33"],
      "source_reference_ids": ["GEN-09", "GEN-10"]
    },
    {
      "action": "add",
      "path": "region",
      "value_after": {
        "country": "string",
        "nUTS": "string",
        "federal_state": "string",
        "district": "string",
        "municipality": "string",
        "is_mountain_area": "boolean",
        "is_protected_area": "boolean",
        "water_protection_zone": "boolean"
      },
      "rationale": "The evaluator needs a root-level region record for Austrian eligibility and the drought district list.",
      "rule_ids": ["O62-R30", "O62-R37"],
      "source_reference_ids": ["GEN-03", "NOTICE-0805-01", "NOTICE-0812-01"]
    },
    {
      "action": "add",
      "path": "program",
      "value_after": {
        "o6_1a": {"participates": "boolean"},
        "o6_1b": {"participates": "boolean", "partial_farm": "boolean"},
        "o6_2": {"participates": "boolean", "application_year": "int|null", "application_date": "date|null"},
        "change_date": "date|null",
        "target_measure": "string|null"
      },
      "rationale": "Participation, combination, application and measure-change state are absent from the canonical profile.",
      "rule_ids": ["O62-R03", "O62-R20", "O62-R21", "O62-R22", "O62-R23"],
      "source_reference_ids": ["O62-03", "O62-21", "O62-22", "O62-24", "O62-25"]
    }
  ]
}
