{
  "contract_version": "rules-catalog-v2.0.0",
  "measure": "o6_16",
  "rules": [
    {"id":"o6_16.contract.term","rule_type":"contract_duration","statement":"Die Grundmaßnahme einschließlich Wiener Humus-Zuschlag läuft je nach Einstieg 4, 5 oder 6 Jahre, stets bis 31.12.2028.","conditions":[{"expression":"entry_year in {2023,2024,2025}","description":"Einstieg in die mehrjährige Maßnahme","input_paths":["farm.year","oepul.o6_16.entry_year"]}],"result":{"outcome":"contract_required","description":"Verpflichtungen bis 31.12.2028 erfüllen."},"source_reference_ids":["src.measure.p2"],"rego_symbols":["eligible"]},
    {"id":"o6_16.cover_crop.combination","rule_type":"eligibility","statement":"Zeitgleich ist Begrünung von Ackerflächen – Zwischenfruchtanbau oder System Immergrün zu beantragen.","conditions":[{"expression":"o6_16.enrolled","description":"Teilnahme an o6_16","input_paths":["oepul.o6_16.enrolled","oepul.o6_16.cover_crop_measure"]}],"result":{"outcome":"combination_required","description":"Eine der zwei Begrünungsmaßnahmen ist Voraussetzung."},"source_reference_ids":["src.measure.p2","src.law.p74"],"rego_symbols":["eligible"]},
    {"id":"o6_16.minimum_area","rule_type":"eligibility","statement":"Im ersten Teilnahmejahr sind mindestens 2,00 ha Acker in der Anhang-G-Gebietskulisse erforderlich; danach darf die Fläche kleiner sein.","conditions":[{"expression":"first_year","description":"Erstes Teilnahmejahr","input_paths":["oepul.o6_16.first_year_area_in_eligible_zone_ha"]}],"result":{"outcome":"minimum_area","description":"Mindestens 2 ha innerhalb der Kulisse."},"source_reference_ids":["src.measure.p2","src.law.p74","src.annex.g"],"rego_symbols":["eligible","kg_in_eligible_zone"]},
    {"id":"o6_16.records.business","rule_type":"recordkeeping","statement":"Auf allen Betriebsflächen sind NAPV-konforme betriebliche Aufzeichnungen einschließlich Bedarf, Tier-N, Ausbringung/Bewässerung und Vorfruchtwirkung zu führen.","conditions":[{"expression":"o6_16.enrolled","description":"Teilnahme","input_paths":["documentation.nutrient_balance_complete"]}],"result":{"outcome":"records_required","description":"Vollständige betriebliche N-Aufzeichnungen."},"source_reference_ids":["src.measure.p3","src.law.p74"],"rego_symbols":["violations"]},
    {"id":"o6_16.records.business_deadlines","rule_type":"deadline","statement":"Die Düngeplanung ist bis 28. Februar des Förderjahres anzulegen und die Bilanz bis 31. Jänner des Folgejahres abzuschließen.","conditions":[{"expression":"o6_16.enrolled","description":"Teilnahme","input_paths":["oepul.o6_16.business_plan_date","oepul.o6_16.business_balance_date"]}],"result":{"outcome":"deadline","description":"Plan bis 28.02., Bilanz bis 31.01. Folgejahr."},"source_reference_ids":["src.measure.p3","src.law.p74"],"rego_symbols":["violations"]},
    {"id":"o6_16.records.field","rule_type":"recordkeeping","statement":"Für Kulissen-Ackerflächen sind elektronische schlagbezogene N-Aufzeichnungen mit Schlagdaten, Düngung, Bewässerung, Anbau/Ernte, Erntemenge/Wiegebelegen und N-Saldo zu führen.","conditions":[{"expression":"parcel.in_eligible_zone and crop_area_ha > 0.30","description":"Aufzeichnungspflichtiger Schlag","input_paths":["oepul.o6_16.parcels[]"]}],"result":{"outcome":"records_required","description":"Elektronische, bedarfsweise vorlegbare Schlagaufzeichnung."},"source_reference_ids":["src.measure.p3","src.measure.p4","src.law.p74"],"rego_symbols":["violations"]},
    {"id":"o6_16.records.field_exception","rule_type":"exception","statement":"Bei Kulturen mit höchstens 0,30 ha je Kultur sind keine schlagbezogenen Aufzeichnungen erforderlich; vergleichbare Schläge dürfen zusammengefasst werden.","conditions":[{"expression":"crop_area_ha <= 0.30","description":"Kleinflächenkultur","input_paths":["oepul.o6_16.parcels[].crop_area_ha"]}],"result":{"outcome":"exempt","description":"Keine schlagbezogene Aufzeichnungspflicht."},"source_reference_ids":["src.measure.p3","src.law.p74"]},
    {"id":"o6_16.records.field_deadline","rule_type":"deadline","statement":"Schlagaufzeichnungen sind zeitnah, spätestens 14 Tage nach N-Ausbringung, Anbau, Bewässerung oder Ernte fertigzustellen.","conditions":[{"expression":"recordable_event","description":"Ereignis am Schlag","input_paths":["oepul.o6_16.parcels[].record_completion_days_after_event"]}],"result":{"outcome":"deadline","description":"Fertigstellung innerhalb 14 Tagen."},"source_reference_ids":["src.measure.p3"],"rego_symbols":["violations"]},
    {"id":"o6_16.nitrogen.transfer","rule_type":"calculation","statement":"Ein positiver Vorfrucht-N-Saldo über 10 kg/ha bis 2024 bzw. über 20 kg/ha ab 2025 ist auf die Folgekultur anzurechnen; ab 2025 höchstens 100 kg/ha vor Reduktionsfaktor.","conditions":[{"expression":"previous_nitrogen_surplus_kg_per_ha > threshold","description":"Positiver anrechenbarer Saldo","input_paths":["oepul.o6_16.parcels[].previous_nitrogen_surplus_kg_per_ha","farm.year"]}],"result":{"outcome":"n_reduction","description":"Folgekulturdüngung reduzieren."},"source_reference_ids":["src.measure.p4","src.law.p74"],"rego_symbols":["nitrogen_transfer_kg_per_ha","violations"]},
    {"id":"o6_16.nitrogen.transfer_rate","rule_type":"calculation","statement":"Die Kürzung beträgt in nördlichem/mittlerem Burgenland, östlichem Niederösterreich einschließlich Tullnerfeld und Wien 80 %, sonst 60 % des Überschusses.","conditions":[{"expression":"surplus_above_threshold","description":"Anrechenbarer Saldo","input_paths":["oepul.o6_16.parcels[].high_reduction_area"]}],"result":{"outcome":"n_reduction_rate","description":"80 % oder 60 % übertragen."},"source_reference_ids":["src.measure.p4","src.law.p74"],"rego_symbols":["nitrogen_transfer_kg_per_ha"]},
    {"id":"o6_16.nitrogen.autumn_crop","rule_type":"cultivation","statement":"Bei Saldo über 30 kg/ha, Feldgemüse/Kürbis über 0,30 ha als Vorfrucht oder Umbruch von Ackerfutter/Ackerbrache vor 15.11. ist bis 15.11. Folge- oder zulässige Zwischenfrucht anzulegen; ausgenommen spät nach 30.09. geerntete Kulturen, nicht aber Ackerfutterumbruch.","conditions":[{"expression":"surplus > 30 or specified_pre_crop","description":"Herbstanlageauslöser","input_paths":["oepul.o6_16.parcels[].autumn_follow_crop_or_eligible_cover_by_15_nov"]}],"result":{"outcome":"autumn_crop_required","description":"Herbstliche Anlage erforderlich."},"source_reference_ids":["src.measure.p4","src.measure.p5","src.law.p74","src.law.p75"],"rego_symbols":["violations"]},
    {"id":"o6_16.training","rule_type":"training","statement":"Bis 31.12.2026 sind mindestens 10 Stunden anerkannte fachspezifische Weiterbildung zu absolvieren; danach ist einmalig ein Gewässerschutzkonzept zu erstellen.","conditions":[{"expression":"o6_16.enrolled","description":"Teilnahme","input_paths":["oepul.o6_16.training_hours","oepul.o6_16.water_protection_concept_completed"]}],"result":{"outcome":"training_and_concept_required","description":"10 Stunden und Konzept bis 31.12.2026."},"source_reference_ids":["src.measure.p7","src.law.p75"],"rego_symbols":["violations"]},
    {"id":"o6_16.training_person","rule_type":"exception","statement":"Kursbesuche ab 01.01.2022 sind anrechenbar und dürfen von einer maßgeblich am Betrieb tätigen Person erbracht werden; verlässt sie den Betrieb vor dem Stichtag, ist nachzuholen.","conditions":[{"expression":"trained_person_left_before_2026_12_31","description":"Geschulte Person scheidet rechtzeitig aus","input_paths":["oepul.o6_16.trained_person_left_date"]}],"result":{"outcome":"replacement_training_required","description":"Kurs bis 31.12.2026 nachholen."},"source_reference_ids":["src.measure.p7"]},
    {"id":"o6_16.soil_samples","rule_type":"calculation","statement":"Bis 31.12.2026 ist pro angefangene 5 ha Kulissenacker gemäß Mehrfachantrag 2026 eine Bodenprobe an ein akkreditiertes Labor zu übermitteln und im GIS zu erfassen.","conditions":[{"expression":"area_2026 > 0","description":"Kulissenacker im MFA 2026","input_paths":["oepul.o6_16.arable_area_eligible_zone_2026_ha","oepul.o6_16.accredited_soil_samples_submitted"]}],"result":{"outcome":"soil_sample_count","description":"ceil(ha/5) akkreditierte Proben."},"source_reference_ids":["src.measure.p8","src.law.p75"],"rego_symbols":["required_soil_samples","violations"]},
    {"id":"o6_16.soil_samples.parameters","rule_type":"laboratory","statement":"Die Probe umfasst N, P, K, pH und Humus nach Richtlinien für sachgerechte Düngung oder EUF; N umfasst nachlieferbaren oder mineralischen N.","conditions":[{"expression":"soil_sample_submitted","description":"Bodenuntersuchung","input_paths":["oepul.o6_16.soil_sample_parameters"]}],"result":{"outcome":"parameters_required","description":"Alle genannten Parameter analysieren."},"source_reference_ids":["src.measure.p7","src.law.p75"]},
    {"id":"o6_16.psm.ban","rule_type":"prohibition","statement":"In der Kulisse sind Dimethachlor, Metazachlor, S-Metolachlor, Terbuthylazin und bei Wiederzulassung Bentazon bei Sorghum, Sudangras, Mais einschließlich Zucker-/Saatmais, Raps, Soja und Zuckerrübe verboten.","conditions":[{"expression":"parcel.in_eligible_zone and crop in restricted_crops","description":"Betroffene Kultur in Gebiet","input_paths":["oepul.o6_16.parcels[].crop","oepul.o6_16.parcels[].active_ingredients"]}],"result":{"outcome":"prohibited","description":"Keinen gelisteten Wirkstoff anwenden."},"source_reference_ids":["src.measure.p9","src.law.p75"],"rego_symbols":["violations"]},
    {"id":"o6_16.upper_austria","rule_type":"regional_requirement","statement":"In Oberösterreich gelten Sperrfristen, Gabenteilung über 80 kg N/ha, Verbot der Begrünungsvariante 3 und Dokumentation von Kontrollgang oder Warndienst vor chemischer Pflanzenschutzmaßnahme.","conditions":[{"expression":"parcel.upper_austria","description":"Kulissenfläche in Oberösterreich","input_paths":["oepul.o6_16.parcels[]"]}],"result":{"outcome":"additional_requirements","description":"Alle vier OÖ-Zusatzauflagen einhalten."},"source_reference_ids":["src.measure.p9","src.measure.p10","src.law.p75"],"rego_symbols":["violations"]},
    {"id":"o6_16.ag.eligibility","rule_type":"option","statement":"AG ist nur für mindestens einen Kulissenschlag mit durchschnittlicher Ackerzahl höchstens 40 verfügbar.","conditions":[{"expression":"parcel.ag_option","description":"Option auf Schlag beantragt","input_paths":["oepul.o6_16.parcels[].average_soil_number"]}],"result":{"outcome":"eligible_if","description":"Ackerzahl ≤ 40."},"source_reference_ids":["src.measure.p10","src.law.p75"],"rego_symbols":["violations"]},
    {"id":"o6_16.ag.management","rule_type":"option","statement":"AG verlangt winterharte, leguminosenfreie Begrünung bis 15.05. oder bestehenden Grünbrache-/Ackerfutterbestand, Umbruch frühestens 15.09. des zweiten Jahres, keine Düngung/PSM, Mahd/Häckseln mindestens alle zwei Jahre und kein Weiden/Drusch.","conditions":[{"expression":"parcel.ag_option","description":"AG-Schlag","input_paths":["oepul.o6_16.parcels[].ag_sown_date"]}],"result":{"outcome":"management_required","description":"AG-Auflagen einhalten."},"source_reference_ids":["src.measure.p10","src.law.p75","src.law.p76"],"rego_symbols":["violations"]},
    {"id":"o6_16.wien.humus","rule_type":"option","statement":"Wiener Humus-Zuschlag verbietet wendende Bodenbearbeitung außer nach Mais, verlangt Projektbestätigung/-daten, 3 Zusatzstunden bis 31.12.2026 und zwei Proben je angefangene 5 ha.","conditions":[{"expression":"wien_humus_option","description":"Wiener Zuschlag beantragt","input_paths":["oepul.o6_16.wien_humus_option"]}],"result":{"outcome":"management_required","description":"Alle Wiener Zuschlagsauflagen."},"source_reference_ids":["src.measure.p11","src.law.p76"],"rego_symbols":["required_wien_soil_samples","violations"]},
    {"id":"o6_16.pig_feed","rule_type":"option","statement":"Der Schweinefütterungszuschlag setzt ≥1,00 GVE Schweine je ha gesamte Ackerfläche voraus und verlangt die Rohproteingrenzen für alle Schweine samt Rezeptur-/Phasenfütterungsnachweis.","conditions":[{"expression":"pig_feed_option","description":"Schweinezuschlag beantragt","input_paths":["oepul.o6_16.pig_gve_per_arable_ha","oepul.o6_16.pig_protein_g_per_kg_88_tm"]}],"result":{"outcome":"eligible_if","description":"Besatz, Proteinobergrenzen und Nachweis einhalten."},"source_reference_ids":["src.measure.p11","src.measure.p12","src.law.p74","src.law.p76"],"rego_symbols":["violations"]},
    {"id":"o6_16.cultan","rule_type":"option","statement":"Ab Antragsjahr 2025 verlangt Cultan je beantragtem Schlag mindestens eine Injektion als Ammoniumdepot im Cultan-Nagelradverfahren, Schlagaufzeichnung und bei Fremdgerät einen Nachweis.","conditions":[{"expression":"cultan_option","description":"Cultan beantragt","input_paths":["oepul.o6_16.cultan_option","oepul.o6_16.parcels[]"]}],"result":{"outcome":"management_required","description":"Cultan-Auflagen einhalten."},"source_reference_ids":["src.measure.p12","src.measure.p13","src.law.p77"],"rego_symbols":["violations"]},
    {"id":"o6_16.application","rule_type":"application","statement":"Grundmaßnahme, Wiener und Schweine-Zuschlag brauchen einen Maßnahmenantrag bis 31.12. vor Vertragsbeginn; AG und Cultan werden im Teilnahmejahr über AG bzw. CUL am Schlag beantragt.","conditions":[{"expression":"requested_option","description":"Teilnahme bzw. Option","input_paths":["oepul.o6_16.application_date"]}],"result":{"outcome":"application_required","description":"Frist und passenden Code verwenden."},"source_reference_ids":["src.measure.p13","src.measure.p14"]},
    {"id":"o6_16.premium","rule_type":"payment","statement":"Die Basisprämie beträgt ab 2024 54 €/ha bzw. bei BIO oder Einschränkung ertragssteigernder Betriebsmittel 27 €/ha; weitere Prämien und Höchstflächen richten sich nach der Tabelle.","conditions":[{"expression":"eligible_area","description":"Förderfähige Fläche","input_paths":["farm.year","oepul.o6_16.bio_or_eb"]}],"result":{"outcome":"premium_rate","description":"Tabellensatz anwenden."},"source_reference_ids":["src.measure.p14","src.measure.p15","src.law.p77"],"rego_symbols":["premium_base_for_participation_eur_per_ha","ag_option_premium_area_ha"]},
    {"id":"o6_16.premium.combinations","rule_type":"combination","statement":"PSM-Verzicht ist nicht mit BIO kombinierbar; Wiener Zuschlag nicht mit Erosionsschutz-Acker Mulch-/Direkt-/Strip-Till; AG erhält keine Basisprämie und keine andere Einzelflächen-ÖPUL-Prämie außer LSE-Abgeltung.","conditions":[{"expression":"claimed_combinations","description":"Mehrfachbeantragung auf Fläche","input_paths":["oepul.o6_16.parcels[]"]}],"result":{"outcome":"incompatible","description":"Unzulässige Kombination nicht auszahlen."},"source_reference_ids":["src.measure.p15","src.law.p76","src.law.p77"]},
    {"id":"o6_16.ag.ineligible_land","rule_type":"eligibility","statement":"AG ist nicht förderfähig auf 2020 als Grünland beantragtem Acker sowie auf GLÖZ-4-Pufferstreifen und bis 2024 GLÖZ-8-Stilllegung.","conditions":[{"expression":"parcel.ag_option","description":"AG-Schlag","input_paths":["oepul.o6_16.parcels[].was_grassland_2020"]}],"result":{"outcome":"ineligible","description":"Keine AG-Prämie auf ausgeschlossenen Flächen."},"source_reference_ids":["src.measure.p15","src.law.p76","src.law.p77"]},
    {"id":"o6_16.general.minimum_management","rule_type":"general_eligibility","statement":"Acker benötigt ordnungsgemäßen Anbau und Pflege sowie Ernte und Verbringung auf mindestens 85 % des Schlages; AG ist davon nach seinen Sonderauflagen ausgenommen.","conditions":[{"expression":"eligible_arable_parcel","description":"Förderfähiger Ackerschlag","input_paths":["oepul.o6_16.parcels[].harvested_percent"]}],"result":{"outcome":"minimum_management","description":"85%-Erntepflicht, vorbehaltlich Ausnahme."},"source_reference_ids":["src.general.p5","src.general.p6","src.general.p7"]},
    {"id":"o6_16.general.duration","rule_type":"general_contract","statement":"Förderverpflichtungen gelten grundsätzlich vom 1. Jänner bis 31. Dezember; Flächen sind nur förderfähig, wenn sie während der ganzen Dauer erfüllt sind.","conditions":[{"expression":"claimed_unit","description":"Beantragte Fläche","input_paths":["oepul.o6_16.parcels[]"]}],"result":{"outcome":"whole_year_required","description":"Ganzjährige Einhaltung."},"source_reference_ids":["src.general.p10"]},
    {"id":"o6_16.general.exits","rule_type":"general_contract","statement":"Vorzeitiger Ausstieg aus mehrjährigen Verpflichtungen führt grundsätzlich zur Rückforderung; einjährige Optionen verlängern sich ohne Abmeldung automatisch.","conditions":[{"expression":"exit_or_nonrenewal","description":"Ausstieg oder Abmeldung","input_paths":["oepul.o6_16.exit_date"]}],"result":{"outcome":"consequence","description":"Rückforderung oder Ende des Förderjahres beachten."},"source_reference_ids":["src.general.p13"]},
    {"id":"o6_16.general.area_reduction","rule_type":"general_contract","statement":"Bei Flächenabgängen sind jährlich 5 %, höchstens 5 ha und jedenfalls 0,50 ha toleriert; darüber sind Differenzflächen rückzahlungspflichtig.","conditions":[{"expression":"area_reduction","description":"Verringerung mehrjähriger Maßnahmenfläche","input_paths":["oepul.o6_16.previous_area_ha","oepul.o6_16.current_area_ha"]}],"result":{"outcome":"repayment_if_exceeded","description":"Toleranzgrenze anwenden."},"source_reference_ids":["src.general.p15","src.general.p16"]},
    {"id":"o6_16.general.area_access","rule_type":"general_contract","statement":"Zugänge sind 2024/2025 voll prämienfähig; danach höchstens 50 % der Fläche 2025, aber mindestens 5 ha Zuwachs.","conditions":[{"expression":"area_access_after_2025","description":"Flächenzugang","input_paths":["oepul.o6_16.area_2025_ha","oepul.o6_16.current_area_ha"]}],"result":{"outcome":"premium_limited","description":"Zugangslimit anwenden."},"source_reference_ids":["src.general.p17"]},
    {"id":"o6_16.general.sanctions","rule_type":"sanction","statement":"Inhaltliche Verstöße werden nach Schwere, Ausmaß, Dauer und Häufigkeit mit Verwarnung bzw. 2–100 % Kürzung bewertet; zweimal 100 % führt zu Ausschluss und Rückforderung.","conditions":[{"expression":"breach_detected","description":"Festgestellter Verstoß","input_paths":["documentation.audit_last_year_noncompliance"]}],"result":{"outcome":"sanction","description":"Maßnahmenbezogene Sanktion."},"source_reference_ids":["src.general.p17","src.general.p18"]},
    {"id":"o6_16.general.premium_cap_modulation","rule_type":"payment","statement":"Die allgemeinen Flächenprämienobergrenzen und die Betriebsgrößenmodulation (100/90/85/75 % nach 200/300/1000 ha) sind auf die Auszahlung anzuwenden.","conditions":[{"expression":"premium_calculation","description":"Prämienberechnung","input_paths":["land.total_area_ha"]}],"result":{"outcome":"payment_adjusted","description":"Obergrenze und Modulation berücksichtigen."},"source_reference_ids":["src.general.p19"]},
    {"id":"o6_16.drought_2026.harvest","rule_type":"temporary_exception","statement":"2026 entfällt bei Dürre ohne erntbaren Bestand in genannten Bezirken die 85%-Ernte-/Verbringungspflicht ohne Einzelmeldung; die Prämie bleibt erhalten.","conditions":[{"expression":"year == 2026 and drought_no_harvestable_stand and district_listed","description":"Dürre-Ausnahmegebiet","input_paths":["farm.year","farm.region.district","oepul.o6_16.parcels[].drought_no_harvestable_stand"]}],"result":{"outcome":"exempt_with_payment","description":"Keine Einzelmeldung und Prämie bleibt."},"source_reference_ids":["src.notice.aug05","src.notice.aug12"],"rego_symbols":["data.o6_16_reference_data.drought_2026_harvest_exemption_districts"]}
  ]
}
