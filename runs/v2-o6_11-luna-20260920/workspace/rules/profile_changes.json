{
  "contract_version": "profile-changes-v1.0.0",
  "run_id": "v2-o6_11-luna-20260920",
  "measure": "o6_11",
  "changes": [
    {
      "action": "add",
      "path": "farm.oepul",
      "value_after": {
        "o6_11_application_year": 2025,
        "o6_11_contract_start_year": 2025,
        "k20_continuation_only": false,
        "measure_applications": [{"measure_id": "o6_11", "active": true, "participation_type": "whole_farm", "parcel_ids": ["string"]}],
        "herbicide_purchases_storage": [{"product_name": "string", "is_herbicide": false, "permitted_for_other_crops": false, "quantity": 0, "unit": "string", "record_date": "date"}]
      },
      "rationale": "Das Canonical Farm Profile enthält keine Vertrags-, Maßnahmenantrags-, Kombinations- oder Kauf-/Lagerdaten, die für Zugang, Laufzeit, Kombination und das Verbot von Kauf und Lagerung benötigt werden.",
      "rule_ids": ["o6_11.general_minimum_farm_size", "o6_11.contract_period", "o6_11.application_deadline", "o6_11.bio_combination", "o6_11.no_purchase_storage"],
      "source_reference_ids": ["src-legal-minimum-farm", "src-measure-contract-period", "src-measure-application-deadline", "src-measure-bio-combination", "src-measure-purchase-storage"]
    },
    {
      "action": "add",
      "path": "land.protected_cultivation_area_ha",
      "value_after": 0,
      "rationale": "Die allgemeine ÖPUL-Betriebsmindestgröße verwendet geschützten Anbau als eigene 0,50-ha-Alternative; dieses Aggregat fehlt im Ausgangsprofil.",
      "rule_ids": ["o6_11.general_minimum_farm_size"],
      "source_reference_ids": ["src-legal-minimum-farm"]
    },
    {
      "action": "add",
      "path": "land.oepul_eligible_area_ha",
      "value_after": 0,
      "rationale": "Für die allgemeine 1,50-ha-Schwelle wird eine nach der Sonderrichtlinie anrechenbare Flächensumme einschließlich der dort genannten Ergänzungen benötigt.",
      "rule_ids": ["o6_11.general_minimum_farm_size"],
      "source_reference_ids": ["src-legal-minimum-farm"]
    },
    {
      "action": "add",
      "path": "land.parcels[].operations.pesticide_applications",
      "value_after": [{"product_name": "string", "effect_type": "string", "active_ingredient": "string", "is_herbicide": false, "application_date": "date", "area_fraction": 0}],
      "rationale": "Das Profil kennt nur ein boolesches psm_used-Feld; für die verbotsrelevante Wirkungstypprüfung, Ameisensäure und die zeitliche Vollständigkeit der Herbizidfreiheit sind schlagbezogene Anwendungen erforderlich.",
      "rule_ids": ["o6_11.full_herbicide_ban", "o6_11.effect_type_controls", "o6_11.formic_acid", "o6_11.psm_reporting_2023_2025"],
      "source_reference_ids": ["src-measure-herbicide-ban", "src-measure-effect-type", "src-measure-formic-acid", "src-measure-psm-codes"]
    },
    {
      "action": "add",
      "path": "land.parcels[].crop.plant_material_is_grafted",
      "value_after": true,
      "rationale": "Für Obstflächen muss zwischen qualitativ hochwertigem/veredeltem und unveredeltem Pflanzgut unterschieden werden.",
      "rule_ids": ["o6_11.quality_plant_material", "o6_11.excluded_premium_uses"],
      "source_reference_ids": ["src-measure-plant-material", "src-measure-excluded-crops"]
    },
    {
      "action": "add",
      "path": "land.parcels[].o6_11_code",
      "value_after": "string|null",
      "rationale": "OP bzw. maßnahmenbezogene OP-Codes schließen eine Fläche von der jeweiligen Prämie aus und müssen für Ausnahmen oder nicht erfüllte Verpflichtungen abbildbar sein.",
      "rule_ids": ["o6_11.quality_plant_material", "o6_11.excluded_premium_uses", "o6_11.commitment_and_transfer"],
      "source_reference_ids": ["src-measure-plant-material", "src-general-obligation-period"]
    },
    {
      "action": "add",
      "path": "land.parcels[].location_country",
      "value_after": "string",
      "rationale": "Die Förderfähigkeit ist auf in Österreich liegende Flächen beschränkt; das bestehende Profil enthält nur Regionenschlüssel ohne explizites Flächenland.",
      "rule_ids": ["o6_11.austrian_location"],
      "source_reference_ids": ["src-legal-location", "src-general-location"]
    },
    {
      "action": "add",
      "path": "land.parcels[].management_records",
      "value_after": [{"proper_planting": true, "annual_care": true, "harvest_removed": true, "commitment_period_complete": true}],
      "rationale": "Die allgemeinen Mindestbewirtschaftungskriterien und die vollständige Verpflichtungsdauer sind im Canonical Farm Profile nicht als überprüfbare Dokumentations-/Tatsachenfelder enthalten.",
      "rule_ids": ["o6_11.minimum_management", "o6_11.commitment_and_transfer"],
      "source_reference_ids": ["src-legal-minimum-management", "src-general-obligation-period", "src-legal-obligation-period"]
    },
    {
      "action": "add",
      "path": "farm.applicant",
      "value_after": {"is_active_farmer": true, "operates_in_own_name_and_account": true, "has_disposal_rights": true, "public_authority_control_percent": 0},
      "rationale": "Die allgemeinen Fördervoraussetzungen verlangen aktiven Landwirt, landwirtschaftliche Tätigkeit und Verfügungsgewalt; diese Antragstellermerkmale fehlen im Profil.",
      "rule_ids": ["o6_11.austrian_location", "o6_11.commitment_and_transfer"],
      "source_reference_ids": ["src-legal-location", "src-general-obligation-period"]
    }
  ]
}
