  "references": [
    {"reference_id":"WEIDE_P1","source_id":"o6_20_tierwohl_weide_2025_10","source_path":"workspace/sources/o6_20_tierwohl_weide_2025_10.pdf","source_sha256":"05333469ebd18f45f83be795e807fe0a0deda1c4585054109394c63789b09f9e","page":1,"section":"3.1 Vertragszeitraum; 3.2 Mindestteilnahme","claim":"Jahresvertrag und Mindest-RGVE.","evidence_text":"Der Betrieb muss im jeweiligen Teilnahmejahr mit mindestens 2,00 raufutterverzehrenden Großvieheinheiten (RGVE) teilnehmen.","used_by":[{"artifact_path":"workspace/rules/rules.json","symbol":"o6_20.contract.annual","line_start":null,"line_end":null}]},
    {"reference_id":"WEIDE_P2","source_id":"o6_20_tierwohl_weide_2025_10","source_path":"workspace/sources/o6_20_tierwohl_weide_2025_10.pdf","source_sha256":"05333469ebd18f45f83be795e807fe0a0deda1c4585054109394c63789b09f9e","page":2,"section":"3.2 Mindestteilnahme","claim":"Kategoriebezogene Anwesenheit und Vertragsende.","evidence_text":"Es muss zumindest ein Tier der beantragten Kategorie während der Weideperiode zumindest 120 oder 150 Tage am Betrieb sein.","used_by":[{"artifact_path":"workspace/rules/rules.json","symbol":"o6_20.minimum.category_presence","line_start":null,"line_end":null}]},
    {"reference_id":"WEIDE_P3","source_id":"o6_20_tierwohl_weide_2025_10","source_path":"workspace/sources/o6_20_tierwohl_weide_2025_10.pdf","source_sha256":"05333469ebd18f45f83be795e807fe0a0deda1c4585054109394c63789b09f9e","page":3,"section":"4 Tierkategorien und Zuschlag; 5.1 und 5.2","claim":"Kategorien und Kern-Weidepflicht.","evidence_text":"Die Weidehaltung hat an mindestens 120 Tagen im Zeitraum von 1. April bis einschließlich 31. Oktober mit allen Tieren der jeweils beantragten Kategorie zu erfolgen.","used_by":[{"artifact_path":"workspace/policy/o6_20.rego","symbol":"required_days","line_start":null,"line_end":null}]},
    {"reference_id":"WEIDE_P4","source_id":"o6_20_tierwohl_weide_2025_10","source_path":"workspace/sources/o6_20_tierwohl_weide_2025_10.pdf","source_sha256":"05333469ebd18f45f83be795e807fe0a0deda1c4585054109394c63789b09f9e","page":4,"section":"5.3 Zugangsmöglichkeit; 5.4 Aufzeichnungsverpflichtung","claim":"Tränke, Unterstand und Weidetagebuch.","evidence_text":"Die Weidehaltung ist laufend in einem Weidetagebuch zu dokumentieren.","used_by":[{"artifact_path":"workspace/policy/o6_20.rego","symbol":"category_violations","line_start":null,"line_end":null}]},
    {"reference_id":"WEIDE_P5","source_id":"o6_20_tierwohl_weide_2025_10","source_path":"workspace/sources/o6_20_tierwohl_weide_2025_10.pdf","source_sha256":"05333469ebd18f45f83be795e807fe0a0deda1c4585054109394c63789b09f9e","page":5,"section":"6 Meldepflichten; 6.1 Rinder","claim":"Meldepflicht und Rinder-Ausnahmen.","evidence_text":"Für die betroffenen Tiere erfolgt keine Prämiengewährung.","used_by":[{"artifact_path":"workspace/rules/rules.json","symbol":"o6_20.reporting.cattle","line_start":null,"line_end":null}]},
    {"reference_id":"WEIDE_P6","source_id":"o6_20_tierwohl_weide_2025_10","source_path":"workspace/sources/o6_20_tierwohl_weide_2025_10.pdf","source_sha256":"05333469ebd18f45f83be795e807fe0a0deda1c4585054109394c63789b09f9e","page":6,"section":"6.2.1 Meldung Zu- und Abgänge","claim":"Schaf- und Ziegenbewegungen.","evidence_text":"Die Meldung von Zugängen (Zukauf, in die Tierkategorie hineingewachsene Tiere) ist bei weiblichen Schafen und Ziegen innerhalb von 7 Tagen online mittels Korrektur auf www.eama.at durchzuführen.","used_by":[{"artifact_path":"workspace/rules/rules.json","symbol":"o6_20.reporting.sheep_goat_movements","line_start":null,"line_end":null}]},
    {"reference_id":"WEIDE_P7","source_id":"o6_20_tierwohl_weide_2025_10","source_path":"workspace/sources/o6_20_tierwohl_weide_2025_10.pdf","source_sha256":"05333469ebd18f45f83be795e807fe0a0deda1c4585054109394c63789b09f9e","page":7,"section":"6.2.1 und 6.2.2","claim":"Alpung und Nichtteilnahme Schafe/Ziegen.","evidence_text":"Betriebe, die ihre zumindest 120- oder 150-tägige Weideverpflichtung ausschließlich über die Alpung erfüllen, müssen die Tiere neben den Meldungen am Almbetrieb auch am Heimbetrieb in der Beilage „Tierwohl – Weide/Stallhaltung“ beantragen.","used_by":[{"artifact_path":"workspace/rules/rules.json","symbol":"o6_20.reporting.sheep_goat_alp","line_start":null,"line_end":null}]},
    {"reference_id":"WEIDE_P8","source_id":"o6_20_tierwohl_weide_2025_10","source_path":"workspace/sources/o6_20_tierwohl_weide_2025_10.pdf","source_sha256":"05333469ebd18f45f83be795e807fe0a0deda1c4585054109394c63789b09f9e","page":8,"section":"6.3 Equiden und Neuweltkamele; 7 Beantragung","claim":"Korrektur Anzahl und Antragsfristen.","evidence_text":"Der letzte Einstieg in Kategorien der Maßnahme „Tierwohl – Weide“ ist mit dem Förderjahr 2027 möglich","used_by":[{"artifact_path":"workspace/rules/rules.json","symbol":"o6_20.application.categories","line_start":null,"line_end":null}]},
    {"reference_id":"WEIDE_P10","source_id":"o6_20_tierwohl_weide_2025_10","source_path":"workspace/sources/o6_20_tierwohl_weide_2025_10.pdf","source_sha256":"05333469ebd18f45f83be795e807fe0a0deda1c4585054109394c63789b09f9e","page":10,"section":"7.1 Rinder; 7.2 Schafe und Ziegen; 7.3 Equiden","claim":"Beantragung und Berechnung nach Tierart.","evidence_text":"Die prämienfähige Beantragung der weiblichen Schafe ab 1 Jahr und weiblichen Ziegen ab 1 Jahr hat einzeltierbezogen zu erfolgen.","used_by":[{"artifact_path":"workspace/rules/rules.json","symbol":"o6_20.application.ruminants","line_start":null,"line_end":null}]},
    {"reference_id":"WEIDE_P11","source_id":"o6_20_tierwohl_weide_2025_10","source_path":"workspace/sources/o6_20_tierwohl_weide_2025_10.pdf","source_sha256":"05333469ebd18f45f83be795e807fe0a0deda1c4585054109394c63789b09f9e","page":11,"section":"7.3 Equiden; 7.4 Neuweltkamele","claim":"Stückzahlbegrenzung für Equiden/Kamele.","evidence_text":"Die Beantragung der Stückzahl muss jedoch bereits im Mehrfachantrag bis spätestens am 15. April (in den Jahren 2023 und 2028 am 17. April) erfolgen, danach sind keine Ausweitungen mehr möglich.","used_by":[{"artifact_path":"workspace/rules/rules.json","symbol":"o6_20.application.equine_camelid","line_start":null,"line_end":null}]},
    {"reference_id":"WEIDE_P12","source_id":"o6_20_tierwohl_weide_2025_10","source_path":"workspace/sources/o6_20_tierwohl_weide_2025_10.pdf","source_sha256":"05333469ebd18f45f83be795e807fe0a0deda1c4585054109394c63789b09f9e","page":12,"section":"8 Ausstieg bzw. Abmeldung; 9 Höhe der Prämie","claim":"Ausstieg und Prämienband.","evidence_text":"Bei den angeführten Beträgen handelt es sich um Prämienbänder, die in Abhängigkeit der beantragten Tiere und verfügbaren Mittel ausbezahlt werden.","used_by":[{"artifact_path":"workspace/rules/rules.json","symbol":"o6_20.payment.base","line_start":null,"line_end":null}]},
    {"reference_id":"WEIDE_P13","source_id":"o6_20_tierwohl_weide_2025_10","source_path":"workspace/sources/o6_20_tierwohl_weide_2025_10.pdf","source_sha256":"05333469ebd18f45f83be795e807fe0a0deda1c4585054109394c63789b09f9e","page":13,"section":"10 RGVE-Schlüssel","claim":"RGVE-Berechnung und Faktoren.","evidence_text":"Bei der Ermittlung der förderfähigen raufutterverzehrenden Großvieheinheiten (RGVE) sind die Umrechnungsfaktoren der untenstehenden Tabelle anzuwenden.","used_by":[{"artifact_path":"workspace/data/o6_20_gve.json","symbol":"/o6_20/gve_factors","line_start":null,"line_end":null}]},
    {"reference_id":"GENERAL_P4","source_id":"o6_allgemeine_teilnahmebedingungen_2026_04","source_path":"workspace/sources/o6_allgemeine_teilnahmebedingungen_2026_04.pdf","source_sha256":"89ad678a94ad109f6ba92563be4650dd0d36a6f3599506a187b56b1398dca120","page":4,"section":"5.1 Konditionalität; 5.2 Förderwerbende Personen","claim":"Allgemeine Förderwerberbedingungen.","evidence_text":"Es muss ein landwirtschaftlicher Betrieb im eigenen Namen und auf eigene Rechnung bewirtschaftet werden sowie die Verfügungsgewalt über die beantragten Flächen gegeben sein.","used_by":[{"artifact_path":"workspace/rules/rules.json","symbol":"o6_20.general.person","line_start":null,"line_end":null}]},
    {"reference_id":"GENERAL_P5","source_id":"o6_allgemeine_teilnahmebedingungen_2026_04","source_path":"workspace/sources/o6_allgemeine_teilnahmebedingungen_2026_04.pdf","source_sha256":"89ad678a94ad109f6ba92563be4650dd0d36a6f3599506a187b56b1398dca120","page":5,"section":"5.2 Förderwerbende Personen; 5.3 Betriebsmindestgröße","claim":"Ausnahme Gebietskörperschaften und Mindestgröße.","evidence_text":"Tierwohl – Weide","used_by":[{"artifact_path":"workspace/rules/rules.json","symbol":"o6_20.general.farm_size","line_start":null,"line_end":null}]},
    {"reference_id":"GENERAL_P9","source_id":"o6_allgemeine_teilnahmebedingungen_2026_04","source_path":"workspace/sources/o6_allgemeine_teilnahmebedingungen_2026_04.pdf","source_sha256":"89ad678a94ad109f6ba92563be4650dd0d36a6f3599506a187b56b1398dca120","page":9,"section":"5.6 Lage der Flächen, Haltungsort der Tiere","claim":"Haltungsort Österreich.","evidence_text":"Die geförderten Tiere müssen in Österreich gehalten werden.","used_by":[{"artifact_path":"workspace/rules/rules.json","symbol":"o6_20.general.austria","line_start":null,"line_end":null}]},
