    {"reference_id":"GENERAL_P13","source_id":"o6_allgemeine_teilnahmebedingungen_2026_04","source_path":"workspace/sources/o6_allgemeine_teilnahmebedingungen_2026_04.pdf","source_sha256":"89ad678a94ad109f6ba92563be4650dd0d36a6f3599506a187b56b1398dca120","page":13,"section":"6 Antragstellung","claim":"Automatische Verlängerung und Ausstieg.","evidence_text":"Die im Maßnahmenantrag beantragten einjährigen Maßnahmen und Optionen verlängern sich automatisch um ein weiteres Förderjahr, wenn sie nicht abgemeldet werden.","used_by":[{"artifact_path":"workspace/rules/rules.json","symbol":"o6_20.exit","line_start":null,"line_end":null}]},
    {"reference_id":"GENERAL_P15","source_id":"o6_allgemeine_teilnahmebedingungen_2026_04","source_path":"workspace/sources/o6_allgemeine_teilnahmebedingungen_2026_04.pdf","source_sha256":"89ad678a94ad109f6ba92563be4650dd0d36a6f3599506a187b56b1398dca120","page":15,"section":"6.3 Maßnahmenübernahme","claim":"Ausnahme für Maßnahmenübernahme.","evidence_text":"Bei der Übernahme von tierbezogenen Maßnahmen müssen Tiere und Flächen vom selben Vorbetrieb stammen.","used_by":[{"artifact_path":"workspace/rules/rules.json","symbol":"o6_20.general.takeover","line_start":null,"line_end":null}]},
