  "source_evidence": {
    "applicant": {
      "page": 4,
      "quote": "juristische Personen, sofern die Beteiligung von Gebietskörperschaften 25 % nicht übersteigt",
      "section": "5.2 Förderwerbende Personen",
      "source": "originals/o6_allgemeine_teilnahmebedingungen_2026_04.pdf"
    },
    "application": {
      "page": 29,
      "quote": "Die Maßnahme „Umweltgerechte und biodiversitätsfördernde Bewirtschaftung“ muss vor Vertragsbeginn im Maßnahmenantrag des Mehrfachantrages bis spätestens am 31. Dezember beantragt werden, um dafür einen gültigen Vertrag ab dem Folgejahr am Betrieb zu begründen.",
      "section": "10 Beantragung",
      "source": "originals/o6_1a_ubb_2026_04.pdf"
    },
    "bm_end": {
      "page": 12,
      "quote": "Mehrfachantrag bis zum Umbruch oder anderweitiger Deklaration der Flächen verboten.",
      "section": "6.1.4.3 Betriebsmitteleinsatz",
      "source": "originals/o6_1a_ubb_2026_04.pdf"
    },
    "botanical": {
      "page": 5,
      "quote": "Nachdem sich Winter- und Sommerform in der botanischen Art nicht unterscheiden, zählen z. B. Wintergerste und Sommergerste als eine Kultur.",
      "section": "5.2 Anbaudiversifizierung",
      "source": "originals/o6_1a_ubb_2026_04.pdf"
    },
    "cereal": {
      "page": 4,
      "quote": "Beträgt die Ackerfläche des Betriebes mehr als 5,00 ha, sind maximal 75 % Getreide und Mais zulässig.",
      "section": "5.2 Anbaudiversifizierung",
      "source": "originals/o6_1a_ubb_2026_04.pdf"
    },
    "cleaning": {
      "page": 19,
      "quote": "Wird der Reinigungsschnitt von der Fläche verbracht, so zählt er als Nutzung, darf aber vor dem 15. Juli durchgeführt werden.",
      "section": "6.2.4.4 DIVRS",
      "source": "originals/o6_1a_ubb_2026_04.pdf"
    },
    "contract": {
      "page": 3,
      "quote": "Der Verpflichtungs- und Vertragszeitraum der Maßnahme beträgt mindestens 4 Jahre und läuft bis 31. Dezember 2028.",
      "section": "3.1 Vertragszeitraum",
      "source": "originals/o6_1a_ubb_2026_04.pdf"
    },
    "div_min": {
      "page": 6,
      "quote": "Ab einer Ackerfläche von mehr als 2,00 ha sind auf zumindest 7 % der Ackerflächen des Betriebes Biodiversitätsflächen oder andere, als Biodiversitätsflächen anrechenbare Flächen anzulegen.",
      "section": "6.1.1 Mindestanlage",
      "source": "originals/o6_1a_ubb_2026_04.pdf"
    },
    "drought": {
      "page": null,
      "quote": "Bei der Variante DIVSZ ist eine vorzeitige Nutzung nur dann möglich, wenn die zweite Mahd auf vergleichbaren Schlägen stattfindet oder bereits stattgefunden hat.",
      "section": "Grünland DIVSZ",
      "source": "notices/2026/2026-05-22__trockenheitsbedingte-ausnahmeregelungen-fuer-oepul-biodiversitaetsflaechen.html"
    },
    "erosion": {
      "page": 33,
      "quote": "auf denen erosionsgefährdete Kulturen (Ackerbohnen, Kartoffeln, Kürbisse, Mais, Rüben,",
      "section": "11.2 Erosionsgefährdete Kulturen",
      "source": "originals/o6_1a_ubb_2026_04.pdf"
    },
    "field_piece": {
      "page": 6,
      "quote": "Auf Acker-Feldstücken mit mehr als 5,00 ha sind am Feldstück Biodiversitätsflächen oder andere, für Biodiversitätsflächen anrechenbare Flächen von in Summe zumindest 0,15 ha anzulegen.",
      "section": "6.1.2 Feldstücksbezogene Anlageverpflichtung",
      "source": "originals/o6_1a_ubb_2026_04.pdf"
    },
    "foreign": {
      "page": 9,
      "quote": "Bewirtschaftete Flächen außerhalb von Österreich werden nicht gefördert und können auch bei diversen Begrenzungen (z. B. Kulturartenanteil) nicht berücksichtigt werden.",
      "section": "5.6 Lage der Flächen",
      "source": "originals/o6_allgemeine_teilnahmebedingungen_2026_04.pdf"
    },
    "invasive": {
      "page": 12,
      "quote": "eine Mahd oder das Häckseln der betroffenen Fläche bereits vor dem 1. August erfolgen",
      "section": "6.1.4.2 Pflege-/Nutzungsauflagen",
      "source": "originals/o6_1a_ubb_2026_04.pdf"
    },
    "nfz": {
      "page": 17,
      "quote": "Der Aufwuchs der ersten und zweiten Nutzung ist von der Fläche abzutransportieren oder zu beweiden, Häckseln ist nicht erlaubt.",
      "section": "6.2.4.2 DIVNFZ",
      "source": "originals/o6_1a_ubb_2026_04.pdf"
    },
    "payment": {
      "page": 22,
      "quote": "jedoch für das betroffene Jahr bezüglich der Maßnahme , Fläche oder sonstigen förderrelevanten Angabe keine Zahlung erfolgen.",
      "section": "1.10.5.3 Zahlungsantrag",
      "source": "legal/20241011_srl_oepul_2023.pdf"
    },
    "rgve": {
      "page": 3,
      "quote": "mindestens 0,30 raufutterverzehrende Großvieheinheiten (RGVE)",
      "section": "4 Tierhaltender Betrieb",
      "source": "originals/o6_1a_ubb_2026_04.pdf"
    },
    "slk": {
      "page": 24,
      "quote": "Als seltene, regional wertvolle landwirtschaftliche Kulturpflanzen auf Ackerflächen gelten sortenrein angebaute Kulturpflanzensorten gemäß Sortenliste unter Kapitel 13.",
      "section": "8.5 Seltene Kulturpflanzen",
      "source": "originals/o6_1a_ubb_2026_04.pdf"
    },
    "slk_open": {
