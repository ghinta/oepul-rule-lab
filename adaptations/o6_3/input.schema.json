            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recognitions"
        }
      },
      "title": "Exceptions",
      "type": "object"
    },
    "Farm": {
      "additionalProperties": false,
      "properties": {
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
