      "additionalProperties": false,
      "properties": {
        "current_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Year"
        },
        "snapshot_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
