            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Combined Measure"
        }
      },
      "title": "Participation",
      "type": "object"
    },
    "Recognition": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "authority": {
          "const": "AMA",
          "title": "Authority",
          "type": "string"
        },
        "recognised": {
          "title": "Recognised",
          "type": "boolean"
        },
        "year": {
          "title": "Year",
          "type": "integer"
        },
        "obligation_id": {
          "enum": [
            "SILAGE",
            "FERMENTATION",
            "STORAGE",
            "GREEN_FEEDING",
            "HAY_TRANSFER",
            "MOWER_CONDITIONER",
            "MINIMUM_MANAGEMENT"
