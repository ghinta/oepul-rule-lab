          "source_sha256": "ec88c013768e73337a093aa3bf6241470462ad1aba26f79fd52f71137ac0aa8f",
          "page": 2,
          "quote": "Die Förderverpflichtungen beziehen sich auf alle Ackerflächen.",
          "section": "3.3 Teilnahmefähige Flächen"
        },
        {
          "source_path": "sources/oepul/originals/o6_allgemeine_teilnahmebedingungen_2026_04.pdf",
          "source_sha256": "89ad678a94ad109f6ba92563be4650dd0d36a6f3599506a187b56b1398dca120",
