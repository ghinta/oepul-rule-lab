    {
      "rule_id": "O67-GAP-DAY-COUNTING",
      "status": "published_component_examples_confirmed_with_separate_criterion_diagnostics",
      "assessment": "The published 40 day main-to-catch gap is ungreened for all 40 days; sowing day is included in the crop and harvest/break day is excluded. The published 41 day invalid catch with 30 days before and 30 after yields 101 known ungreened days. The outer span is deliberately above 50 days, leaving the native A02 interpretation for shorter spans open. Main violations mixes criterion diagnostics and actual aggregate breach, so an individual excessive interval is not automatically proof that the farm 85 percent condition failed.",
      "source_evidence": [
        {
          "source_path": "sources/oepul/originals/o6_7_begruenung_ackerflaechen_system_immergruen_2025_10.pdf",
          "source_sha256": "ec88c013768e73337a093aa3bf6241470462ad1aba26f79fd52f71137ac0aa8f",
          "page": 3,
          "quote": "Der Tag der Anlage der Hauptfrucht bzw. der Zwischenfrucht zählt bereits als Begrünungstag.",
          "section": "5.1 Ganzjährige Begrünung"
        },
        {
          "source_path": "sources/oepul/originals/o6_7_begruenung_ackerflaechen_system_immergruen_2025_10.pdf",
          "source_sha256": "ec88c013768e73337a093aa3bf6241470462ad1aba26f79fd52f71137ac0aa8f",
          "page": 3,
          "quote": "Der Tag der Ernte der Hauptfrucht sowie der Tag des Umbruchs der Ackerfutterfläche oder der Zwischenfrucht zählen nicht als Begrünungstag, sondern als unbegrünt.",
          "section": "5.1 Ganzjährige Begrünung"
        },
        {
          "source_path": "sources/oepul/originals/o6_7_begruenung_ackerflaechen_system_immergruen_2025_10.pdf",
          "source_sha256": "ec88c013768e73337a093aa3bf6241470462ad1aba26f79fd52f71137ac0aa8f",
          "page": 4,
          "quote": "Der Zeitraum zwischen erster Hauptfrucht und Zwischenfrucht entspricht jedoch nicht den Vorgaben und die Fläche zählt daher in den 40 Tagen zur unbegrünten Fläche und darf das Maximum von 15 % der Gesamtfläche nicht überschreiten.",
          "section": "5.1 Beispiel mit 40 Tagen"
        },
        {
          "source_path": "sources/oepul/originals/o6_7_begruenung_ackerflaechen_system_immergruen_2025_10.pdf",
          "source_sha256": "ec88c013768e73337a093aa3bf6241470462ad1aba26f79fd52f71137ac0aa8f",
          "page": 5,
          "quote": "Da die Zwischenfrucht nicht die Mindestdauer von 42 Tagen erreicht, zählen sowohl die 41 Tage Zwischenfrucht als auch die Tage des offenen Bodens vor und nach der Zwischenfrucht als unbegrünt.",
          "section": "5.2.1 Beispiel mit 41 Tagen"
        },
        {
          "source_path": "sources/oepul/originals/o6_7_begruenung_ackerflaechen_system_immergruen_2025_10.pdf",
          "source_sha256": "ec88c013768e73337a093aa3bf6241470462ad1aba26f79fd52f71137ac0aa8f",
          "page": 2,
          "quote": "Es muss eine flächendeckende Begrünung von mindestens 85 % der Ackerfläche zu jedem Zeitpunkt des gesamten Jahres mit Haupt- oder Zwischenfrüchten vorhanden sein.",
          "section": "5.1 Ganzjährige Begrünung"
        }
      ],
