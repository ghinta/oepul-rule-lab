  "rules": [
    {
      "rule_id": "O67-SCOPE-ARABLE-ALL",
      "status": "implemented_land_use_selection_with_geographic_and_collection_limits",
      "assessment": "All provided arable parcels enter the native scope, independently of a selected cover variant. Grassland does not enter the arable base or own premium. The aggregate prefers the provided parcel sum, so a complete current MFA parcel collection and stable identities are upstream requirements; no partial collection is silently treated as complete legal evidence. Eligible premium area and year-round coverage base are separate consumers. The arable sum/base do not themselves filter known foreign parcels, although the monetary consumer does; the General part independently checks the domestic minimum-access consequence. Temporal ownership changes in a current MFA snapshot remain a source/input-contract boundary without a fabricated dynamic denominator oracle.",
      "source_evidence": [
        {
          "source_path": "sources/oepul/originals/o6_7_begruenung_ackerflaechen_system_immergruen_2025_10.pdf",
          "source_sha256": "ec88c013768e73337a093aa3bf6241470462ad1aba26f79fd52f71137ac0aa8f",
          "page": 1,
          "quote": "Die Prämie wird auf allen bewirtschafteten Ackerflächen gewährt.",
