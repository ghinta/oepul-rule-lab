  "blockers": [
    {
      "id": "GROUP_IDENTITY",
      "problem": "App aggregates one group per species, while the RGVE table needs age/breed/size cohorts. A number cannot reconstruct lost categories.",
      "rule_id": "CURRENT_RGVE",
      "required_resolution": "Add stable category cohorts and preserve old species identities/records; revalidate snapshots.",
      "status": "open_before_full_recommendation"
    },
    {
      "id": "COUNT_BASIS",
      "problem": "Presence of average_count alone does not prove an authoritative average list, period or 1-April reference date. The Lab gives any average precedence.",
      "rule_id": "CURRENT_RGVE",
      "required_resolution": "Store count basis, date/period, authoritative list reference/status and category identity; prevent fallback from missing cattle average to current count.",
      "status": "open_before_full_recommendation"
    },
    {
      "id": "GREEN_FEEDING_HISTORY",
      "problem": "Current zero stock is not proof that no roughage-eating animals were held during April–September. The candidate skips this duty when current total_rgve is zero.",
      "rule_id": "GREEN_FEEDING",
      "required_resolution": "Capture seasonal cohort presence and expert assessment method/evidence; unknown history requires review; no invented 92-day threshold.",
      "status": "open_before_full_recommendation"
    },
    {
      "id": "RECOGNITION_TIME",
      "problem": "Candidate matches an AMA recognition only when current as_of lies within its period; an earlier affected period may be missed. Inputs contain no incident interval.",
      "rule_id": "RECOGNITION",
      "required_resolution": "Add affected incident/obligation period and authority-document interpretation; distinguish proof of recognition from legal effect; retain review blocker.",
      "status": "open_before_full_recommendation"
    },
    {
      "id": "GENERAL_FUNDING",
      "problem": "Single-parcel combinations, OP codes, applicant eligibility, area access/growth, caps/modulation/sanctions and mountain-meadow management are excluded from slice.",
      "rule_id": "PREMIUM_AREA",
      "required_resolution": "Integrate source-bound general contract or return explicit blocked full recommendation; never rename slice eligible to complete funding eligibility.",
      "status": "open_before_full_recommendation"
    },
    {
      "id": "ANNUAL_EVIDENCE",
      "problem": "Snapshot date is the observation cutoff, not proof of completed annual compliance or full-year livestock average. Before year-end obligations remain open.",
      "rule_id": "CURRENT_RGVE",
      "required_resolution": "Expose observed/partial/final period coverage and open duties; future completion only a reasoned note, never invent actual facts.",
      "status": "open_before_full_recommendation"
    },
    {
      "id": "SOURCE_CURRENTNESS",
      "problem": "Repository SRL is October 2024 and information sheets October 2025/April 2026; bound hashes prove identity, not absence of later legal amendments.",
      "rule_id": "CONTRACT",
      "required_resolution": "Verify source inventory/version applicability before promotion; document unresolved rank/deltas and exact as-of.",
      "status": "open_before_full_recommendation"
    },
    {
      "id": "OPUS_REVISION",
      "problem": "User-announced completed Opus revisions for 08.10.2026 are not yet available in this baseline.",
      "rule_id": "CURRENT_BASIS",
      "required_resolution": "Bind actual completed artifacts and rerun delta/source review before claiming comparison complete.",
      "status": "open_before_full_recommendation"
    }
  ],
  "promotion_ready": false
}
