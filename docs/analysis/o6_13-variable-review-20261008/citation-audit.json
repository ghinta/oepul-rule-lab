    "source_path": "sources/oepul/originals/o6_allgemeine_teilnahmebedingungen_2026_04.pdf",
    "source_sha256": "89ad678a94ad109f6ba92563be4650dd0d36a6f3599506a187b56b1398dca120",
    "page": 7,
