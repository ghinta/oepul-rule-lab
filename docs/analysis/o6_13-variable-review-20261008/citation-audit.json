    "reference_id": "CIT-AT-10",
    "source_path": "sources/oepul/originals/o6_allgemeine_teilnahmebedingungen_2026_04.pdf",
    "source_sha256": "89ad678a94ad109f6ba92563be4650dd0d36a6f3599506a187b56b1398dca120",
    "page": 5,
    "evidence_text": "Ab dem zweiten ÖPUL-Teilnahmejahr ist die Betriebsmindestgröße generell bei allen Maßnahmen nicht mehr erforderlich.",
    "literal_quote_found": true,
    "normative_entailment": "not_asserted"
  },
  {
    "model": "opus",
    "reference_id": "CIT-AT-11",
    "source_path": "sources/oepul/originals/o6_allgemeine_teilnahmebedingungen_2026_04.pdf",
    "source_sha256": "89ad678a94ad109f6ba92563be4650dd0d36a6f3599506a187b56b1398dca120",
    "page": 5,
    "evidence_text": "Auf Ackerflächen (ausgenommen Ackerfutterflächen) und Flächen im geschützten Anbau:",
    "literal_quote_found": true,
    "normative_entailment": "not_asserted"
  },
  {
    "model": "opus",
    "reference_id": "CIT-AT-12",
    "source_path": "sources/oepul/originals/o6_allgemeine_teilnahmebedingungen_2026_04.pdf",
    "source_sha256": "89ad678a94ad109f6ba92563be4650dd0d36a6f3599506a187b56b1398dca120",
    "page": 6,
    "evidence_text": "Ernte und Verbringen des Erntegutes auf zumindest 85 % des jeweiligen Schlages",
    "literal_quote_found": true,
    "normative_entailment": "not_asserted"
  },
  {
    "model": "opus",
    "reference_id": "CIT-AT-13",
    "source_path": "sources/oepul/originals/o6_allgemeine_teilnahmebedingungen_2026_04.pdf",
    "source_sha256": "89ad678a94ad109f6ba92563be4650dd0d36a6f3599506a187b56b1398dca120",
    "page": 6,
