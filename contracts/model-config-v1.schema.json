{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oepul-rule-lab.invalid/contracts/model-config-v1.schema.json",
  "title": "ÖPUL Rule Lab model adapter configuration v1",
  "oneOf": [
    {"$ref": "#/$defs/codexCli"},
    {"$ref": "#/$defs/externalCommand"}
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["contract_version", "provider", "api_style", "adapter", "model", "timeout_seconds"],
      "properties": {
        "contract_version": {"const": "model-config-v1.0.0"},
        "provider": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,39}$"},
        "api_style": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,39}$"},
        "adapter": {"enum": ["codex-cli", "external-command"]},
        "model": {"type": "string", "minLength": 1, "maxLength": 160},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 7200}
      }
    },
    "codexCli": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["executable", "reasoning_effort", "args"],
          "properties": {
            "contract_version": true,
            "provider": true,
            "api_style": {"const": "codex_cli"},
            "adapter": {"const": "codex-cli"},
            "model": true,
            "timeout_seconds": true,
            "executable": {"type": "string", "minLength": 1},
            "reasoning_effort": {
              "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]
            },
            "args": {"type": "array", "items": {"type": "string"}}
          }
        }
      ]
    },
    "externalCommand": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["command"],
          "properties": {
            "contract_version": true,
            "provider": true,
            "api_style": {"const": "external_command"},
            "adapter": {"const": "external-command"},
            "model": true,
            "timeout_seconds": true,
            "reasoning_effort": {
              "type": ["string", "null"]
            },
            "command": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    }
  }
}
