{
  "$defs": {
    "ArtifactUse": {
      "additionalProperties": false,
      "properties": {
        "artifact_path": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Artifact Path",
          "type": "string"
        },
        "symbol": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "line_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Line Start"
        },
        "line_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Line End"
        }
      },
      "required": [
        "artifact_path",
        "symbol",
        "line_start",
        "line_end"
      ],
      "title": "ArtifactUse",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "reference_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
          "title": "Reference Id",
          "type": "string"
        },
        "source_id": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_path": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Section"
        },
        "claim": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "evidence_text": {
          "maxLength": 600,
          "minLength": 8,
          "title": "Evidence Text",
          "type": "string"
        },
        "used_by": {
          "items": {
            "$ref": "#/$defs/ArtifactUse"
          },
          "minItems": 1,
          "title": "Used By",
          "type": "array"
        }
      },
      "required": [
        "reference_id",
        "source_id",
        "source_path",
        "source_sha256",
        "page",
        "section",
        "claim",
        "evidence_text",
        "used_by"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "source-references-v2.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "run_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "references": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "minItems": 1,
      "title": "References",
      "type": "array"
    }
  },
  "required": [
    "contract_version",
    "run_id",
    "references"
  ],
  "title": "SourceReferencesV2",
  "type": "object"
}
