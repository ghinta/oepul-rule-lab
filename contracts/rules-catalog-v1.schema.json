{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oepul-rule-lab.invalid/contracts/rules-catalog-v1.schema.json",
  "title": "ÖPUL extracted rule catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "measure", "rules"],
  "properties": {
    "contract_version": {"const": "rules-catalog-v1.0.0"},
    "measure": {"type": "string", "pattern": "^o6_[0-9]+[a-z]?$"},
    "rules": {
      "type": "array",
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "rule_type", "statement", "conditions", "result", "sources"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "rule_type": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "conditions": {"type": "array"},
        "result": {},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["document", "page"],
            "properties": {
              "document": {"type": "string", "minLength": 1},
              "page": {"type": ["integer", "null"], "minimum": 1},
              "section": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
