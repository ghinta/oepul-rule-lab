{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oepul-rule-lab.invalid/contracts/artifact-inventory-v2.schema.json",
  "title": "ÖPUL Rule Lab grounded artifact inventory v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_id",
    "source_files",
    "baseline_profile",
    "working_profile",
    "proposed_profile",
    "direct_profile_diff",
    "profile_diff",
    "grounding_validation",
    "structured_rules",
    "source_references",
    "profile_changes",
    "coverage_ledger",
    "data_inventory",
    "rego_modules",
    "data_files",
    "rego_tests",
    "assumptions",
    "raw_log"
  ],
  "properties": {
    "contract_version": {"const": "artifact-inventory-v2.0.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{5,159}$"},
    "source_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "baseline_profile": {"$ref": "#/$defs/file"},
    "working_profile": {"$ref": "#/$defs/file"},
    "proposed_profile": {"$ref": "#/$defs/file"},
    "direct_profile_diff": {"$ref": "#/$defs/file"},
    "profile_diff": {"$ref": "#/$defs/file"},
    "grounding_validation": {"$ref": "#/$defs/file"},
    "structured_rules": {"$ref": "#/$defs/file"},
    "source_references": {"$ref": "#/$defs/file"},
    "profile_changes": {"$ref": "#/$defs/file"},
    "coverage_ledger": {"$ref": "#/$defs/file"},
    "data_inventory": {"$ref": "#/$defs/file"},
    "rego_modules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "data_files": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "rego_tests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "assumptions": {"$ref": "#/$defs/file"},
    "raw_log": {"$ref": "#/$defs/file"}
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
