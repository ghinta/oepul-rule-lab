{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oepul-rule-lab.invalid/contracts/run-comparison-v1.schema.json",
  "title": "ÖPUL Rule Lab run comparison v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "runs"],
  "properties": {
    "contract_version": {"const": "run-comparison-v1.0.0"},
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["run_id", "measure", "mode", "model", "status"]
      }
    }
  }
}
