{
  "$defs": {
    "DataArtifact": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "tables": {
          "items": {
            "$ref": "#/$defs/DataTable"
          },
          "minItems": 1,
          "title": "Tables",
          "type": "array"
        }
      },
      "required": [
        "path",
        "sha256",
        "description",
        "tables"
      ],
      "title": "DataArtifact",
      "type": "object"
    },
    "DataTable": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "json_pointer": {
          "pattern": "^(?:/.*)?$",
          "title": "Json Pointer",
          "type": "string"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "source_reference_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Reference Ids",
          "type": "array"
        }
      },
      "required": [
        "name",
        "json_pointer",
        "row_count",
        "source_reference_ids"
      ],
      "title": "DataTable",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "data-inventory-v1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "run_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/DataArtifact"
      },
      "title": "Artifacts",
      "type": "array"
    }
  },
  "required": [
    "contract_version",
    "run_id",
    "artifacts"
  ],
  "title": "DataInventoryV1",
  "type": "object"
}
