{
  "$defs": {
    "CoverageItem": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
          "title": "Item Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "section",
            "paragraph",
            "table",
            "footnote",
            "notice"
          ],
          "title": "Kind",
          "type": "string"
        },
        "locator": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "page_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page Start"
        },
        "page_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page End"
        },
        "disposition": {
          "enum": [
            "rules",
            "not_rule",
            "unresolved"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "rule_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
            "type": "string"
          },
          "title": "Rule Ids",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "item_id",
        "kind",
        "locator",
        "page_start",
        "page_end",
        "disposition"
      ],
      "title": "CoverageItem",
      "type": "object"
    },
    "CoverageSource": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_path": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "review_scope": {
          "enum": [
            "full_document",
            "targeted_sections"
          ],
          "title": "Review Scope",
          "type": "string"
        },
        "scope_reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope Reason"
        },
        "pages_reviewed": {
          "items": {
            "$ref": "#/$defs/PageRange"
          },
          "title": "Pages Reviewed",
          "type": "array"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/CoverageItem"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "source_path",
        "source_sha256",
        "review_scope",
        "pages_reviewed",
        "items"
      ],
      "title": "CoverageSource",
      "type": "object"
    },
    "PageRange": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "minimum": 1,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 1,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "PageRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "coverage-ledger-v1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "run_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/CoverageSource"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "contract_version",
    "run_id",
    "sources"
  ],
  "title": "CoverageLedgerV1",
  "type": "object"
}
