{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oepul-rule-lab.invalid/contracts/source-references-v1.schema.json",
  "title": "ÖPUL Rule Lab generated-rule source references v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "run_id", "references"],
  "properties": {
    "contract_version": {"const": "source-references-v1.0.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{5,159}$"},
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/reference"}
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_id", "source_id", "source_path", "source_sha256", "page", "section", "claim", "used_by"],
      "properties": {
        "reference_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,119}$"},
        "source_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "source_path": {"$ref": "#/$defs/relativePath"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "page": {"type": ["integer", "null"], "minimum": 1},
        "section": {"type": ["string", "null"], "minLength": 1, "maxLength": 100},
        "claim": {"type": "string", "minLength": 1, "maxLength": 2000},
        "used_by": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/use"}
        }
      }
    },
    "use": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "symbol", "line_start", "line_end"],
      "properties": {
        "artifact_path": {"$ref": "#/$defs/relativePath"},
        "symbol": {"type": "string", "minLength": 1, "maxLength": 200},
        "line_start": {"type": ["integer", "null"], "minimum": 1},
        "line_end": {"type": ["integer", "null"], "minimum": 1}
      }
    }
  }
}
