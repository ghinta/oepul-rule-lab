{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oepul-rule-lab.invalid/contracts/profile-diff-v1.schema.json",
  "title": "ÖPUL Rule Lab finalized profile-diff.json v1",
  "description": "Flattened diff from the baseline to the validated proposed profile.",
  "type": "object",
  "additionalProperties": false,
  "required": ["added", "removed", "changed"],
  "properties": {
    "added": {
      "type": "object",
      "description": "Dot paths present only in the validated proposed profile.",
      "additionalProperties": true
    },
    "removed": {
      "type": "object",
      "description": "Dot paths removed from the baseline by validated proposals.",
      "additionalProperties": true
    },
    "changed": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/replacement"}
    }
  },
  "$defs": {
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": true,
        "after": true
      }
    }
  }
}
