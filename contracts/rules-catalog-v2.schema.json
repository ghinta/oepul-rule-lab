{
  "$defs": {
    "JsonValue": {},
    "Rule": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
          "title": "Id",
          "type": "string"
        },
        "rule_type": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Rule Type",
          "type": "string"
        },
        "statement": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "conditions": {
          "items": {
            "$ref": "#/$defs/RuleCondition"
          },
          "title": "Conditions",
          "type": "array"
        },
        "result": {
          "$ref": "#/$defs/RuleResult"
        },
        "source_reference_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Reference Ids",
          "type": "array"
        },
        "rego_symbols": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Rego Symbols",
          "type": "array"
        }
      },
      "required": [
        "id",
        "rule_type",
        "statement",
        "conditions",
        "result",
        "source_reference_ids"
      ],
      "title": "Rule",
      "type": "object"
    },
    "RuleCondition": {
      "additionalProperties": false,
      "properties": {
        "expression": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Expression",
          "type": "string"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "input_paths": {
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\[\\])?(?:\\.[A-Za-z_][A-Za-z0-9_]*(?:\\[\\])?)*$",
            "type": "string"
          },
          "title": "Input Paths",
          "type": "array"
        }
      },
      "required": [
        "expression",
        "description"
      ],
      "title": "RuleCondition",
      "type": "object"
    },
    "RuleResult": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Outcome",
          "type": "string"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "outcome",
        "description"
      ],
      "title": "RuleResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "rules-catalog-v2.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "measure": {
      "pattern": "^o6_[0-9]+[a-z]?$",
      "title": "Measure",
      "type": "string"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/Rule"
      },
      "minItems": 1,
      "title": "Rules",
      "type": "array"
    }
  },
  "required": [
    "contract_version",
    "measure",
    "rules"
  ],
  "title": "RulesCatalogV2",
  "type": "object"
}
