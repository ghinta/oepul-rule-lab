        "path": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\[\\])?(?:\\.[A-Za-z_][A-Za-z0-9_]*(?:\\[\\])?)*$",
          "title": "Path",
          "type": "string"
        },
        "value_before": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value_after": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rationale": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "rule_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Rule Ids",
          "type": "array"
        },
        "source_reference_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Reference Ids",
          "type": "array"
        }
      },
      "required": [
        "action",
        "path",
        "rationale",
        "rule_ids",
        "source_reference_ids"
      ],
      "title": "ProfileChange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "profile-changes-v1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "run_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "measure": {
